  "metodos": [
    {
      "nome": "Inclinação dos gráficos",
      "telas": [
        {
          "titulo": "A rapidez da mudança de temperatura",
          "blocos": [
            {
              "t": "texto",
              "html": "A taxa de troca de calor P é constante. Num intervalo Δt:"
            },
            {
              "t": "eq",
              "tex": "P\\, \\marca{t}{\\Delta t} = m c\\, \\Delta\\theta"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{\\Delta\\theta}{\\marca{t}{\\Delta t}} = \\dfrac{P}{m c}",
              "mover": [
                "t"
              ]
            },
            {
              "t": "texto",
              "html": "As massas são iguais: a rapidez com que a temperatura muda é <b>inversamente proporcional</b> ao calor específico."
            }
          ]
        },
        {
          "titulo": "Os gráficos",
          "cena": {
            "mostrar": [
              "ordem",
              "aquecimento",
              "resfriamento"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Como c<sub>x</sub> < c<sub>y</sub> < c<sub>z</sub>, a reta de x é a <b>mais inclinada</b>, depois a de y e a de z, no aquecimento e no resfriamento."
            },
            {
              "t": "texto",
              "html": "x chega primeiro a 100 ºC e também volta primeiro a θ<sub>amb</sub>; z é a mais lenta nas duas etapas."
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
