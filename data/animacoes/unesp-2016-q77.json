{
  "id": "unesp-2016-q77",
  "formato": "aula",
  "titulo": "Reduzindo a frequência de engrenagem em engrenagem",
  "conceitos": [
    "Transmissão de movimento circular"
  ],
  "metodos": [
    {
      "nome": "Engrenagens",
      "telas": [
        {
          "titulo": "Engrenagens acopladas",
          "blocos": [
            {
              "t": "texto",
              "html": "Engrenagens acopladas, sem escorregamento, têm a mesma velocidade linear nos dentes:"
            },
            {
              "t": "eq",
              "tex": "2\\pi R_{1} f_{1} = 2\\pi R_{2} f_{2}"
            },
            {
              "t": "texto",
              "html": "O raio é proporcional ao número de dentes N. Então:"
            },
            {
              "t": "eq",
              "tex": "f_{1} N_{1} = f_{2} N_{2}"
            }
          ]
        },
        {
          "titulo": "De A para B, e B com C",
          "blocos": [
            {
              "t": "texto",
              "html": "De A (8 dentes) para B (24 dentes):"
            },
            {
              "t": "eq",
              "tex": "13,5 \\cdot 8 = f_{B} \\cdot 24"
            },
            {
              "t": "eq",
              "tex": "f_{B} = \\dfrac{13,5 \\cdot \\marca{a}{8}}{\\marca{b}{24}} = \\dfrac{13,5}{3} = 4,5\\ \\text{Hz}"
            },
            {
              "t": "texto",
              "html": "C está no mesmo eixo de B: gira com a mesma frequência, f<sub>C</sub> = 4,5 Hz."
            }
          ]
        },
        {
          "titulo": "De C para D: as rodas",
          "blocos": [
            {
              "t": "texto",
              "html": "De C (8 dentes) para D (24 dentes), de novo a frequência fica dividida por 3:"
            },
            {
              "t": "eq",
              "tex": "f_{D} = \\dfrac{4,5 \\cdot 8}{24} = \\dfrac{4,5}{3} = 1,5\\ \\text{Hz}"
            },
            {
              "t": "texto",
              "html": "As rodas estão no eixo de D:"
            },
            {
              "t": "eq",
              "tex": "f_{R} = 1,5\\ \\text{Hz}"
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
