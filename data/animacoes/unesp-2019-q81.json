  "metodos": [
    {
      "nome": "Snell nas duas interfaces",
      "telas": [
        {
          "titulo": "Os ângulos",
          "cena": {
            "mostrar": [
              "camadas",
              "raio",
              "normal",
              "angulos"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "α é o ângulo de <b>incidência</b> na interface A/B: entre o raio, ainda na camada A, e a normal."
            },
            {
              "t": "texto",
              "html": "Na camada B o raio forma o ângulo β com a normal. Na interface B/C a refração é <b>rasante</b>: em C, o raio sai a <b>90º</b> da normal."
            }
          ]
        },
        {
          "titulo": "Snell, de A até C",
          "cena": {
            "mostrar": [
              "camadas",
              "raio",
              "normal",
              "angulos"
            ],
            "destacar": [
              "angulos"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Lei de Snell em cada interface:"
            },
            {
              "t": "eq",
              "tex": "n_{A} \\sen\\alpha = n_{B} \\sen\\beta"
            },
            {
              "t": "eq",
              "tex": "n_{B} \\sen\\beta = n_{C} \\sen 90^{\\circ} = n_{C}"
            },
            {
              "t": "texto",
              "html": "O termo n<sub>B</sub> sen β é o mesmo nas duas equações. Logo:"
            },
            {
              "t": "eq",
              "tex": "\\marca{a}{n_{A}} \\sen\\alpha = n_{C}"
            },
            {
              "t": "eq",
              "tex": "\\sen\\alpha = \\dfrac{n_{C}}{\\marca{a}{n_{A}}}",
              "mover": [
                "a"
              ]
            },
            {
              "t": "texto",
              "html": "O índice da camada B não aparece no resultado."
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
