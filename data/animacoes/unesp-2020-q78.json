  "metodos": [
    {
      "nome": "Conservação da energia",
      "telas": [
        {
          "titulo": "As alturas",
          "cena": {
            "mostrar": [
              "pista",
              "carrinho",
              "desnivel"
            ],
            "animar": [
              "andar"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "No trecho horizontal A, a altura é a de x = 0:"
            },
            {
              "t": "eq",
              "tex": "y_{A} = \\cos 0 = 1\\ \\text{m}"
            },
            {
              "t": "texto",
              "html": "Na posição x = 5π/4 m:"
            },
            {
              "t": "eq",
              "tex": "y = \\cos\\dfrac{5\\pi}{4} = -\\dfrac{\\sqrt{2}}{2} \\approx -0,7\\ \\text{m}"
            },
            {
              "t": "eq",
              "tex": "\\Delta h = 1 - (-0,7) = 1,7\\ \\text{m}"
            }
          ]
        },
        {
          "titulo": "A velocidade",
          "cena": {
            "mostrar": [
              "pista",
              "carrinho",
              "desnivel"
            ],
            "destacar": [
              "desnivel"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Sem atrito, a energia mecânica se conserva. A massa <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{\\marca{a}{m}\\, v_{0}^{2}}{2} + \\marca{b}{m}\\, g\\, \\Delta h = \\dfrac{\\marca{c}{m}\\, v^{2}}{2}"
            },
            {
              "t": "eq",
              "tex": "v^{2} = v_{0}^{2} + 2 g\\, \\Delta h",
              "cancelar": [
                "a",
                "b",
                "c"
              ]
            },
            {
              "t": "eq",
              "tex": "v^{2} = 16 + 2 \\cdot 10 \\cdot 1,7 = 50"
            },
            {
              "t": "eq",
              "tex": "v = \\sqrt{50} = 5\\sqrt{2} = 5 \\cdot 1,4"
            },
            {
              "t": "eq",
              "tex": "v = 7\\ \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
