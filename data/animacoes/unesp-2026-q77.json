  "metodos": [
    {
      "nome": "Pela geometria",
      "telas": [
        {
          "titulo": "Onde está o morador",
          "cena": {
            "mostrar": [
              "terra",
              "latitude"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Oslo está a <b>60º de latitude norte</b>."
            },
            {
              "t": "texto",
              "html": "A latitude é o ângulo entre a linha que liga o lugar ao <b>centro da Terra</b> e o plano do <b>equador</b>."
            },
            {
              "t": "texto",
              "html": "A longitude não influi aqui."
            }
          ]
        },
        {
          "titulo": "A aceleração centrípeta",
          "cena": {
            "mostrar": [
              "terra",
              "latitude",
              "paralelo",
              "acp"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Com a rotação, o morador descreve uma circunferência no plano do seu <b>paralelo</b>."
            },
            {
              "t": "texto",
              "html": "O centro dessa circunferência está sobre o <b>eixo de rotação</b>, e não no centro da Terra."
            },
            {
              "t": "texto",
              "html": "Por isso, a <b>aceleração centrípeta</b> aponta para o eixo, paralela ao plano do equador."
            }
          ]
        },
        {
          "titulo": "O ângulo entre os vetores",
          "cena": {
            "mostrar": [
              "terra",
              "latitude",
              "paralelo",
              "acp",
              "fg"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A <b>força gravitacional</b> aponta para o centro da Terra."
            },
            {
              "t": "texto",
              "html": "A aceleração centrípeta é paralela ao equador, e a força gravitacional segue a linha da latitude."
            },
            {
              "t": "texto",
              "html": "Os dois ângulos marcados são <b>alternos internos</b>: o ângulo entre os dois vetores é a própria latitude."
            },
