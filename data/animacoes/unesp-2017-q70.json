{
  "id": "unesp-2017-q70",
  "formato": "aula",
  "titulo": "O calor do azeite aquecendo a água",
  "conceitos": [
    "Calorimetria",
    "Calor sensível"
  ],
  "metodos": [
    {
      "nome": "Calor sensível",
      "telas": [
        {
          "titulo": "A energia liberada",
          "blocos": [
            {
              "t": "texto",
              "html": "13 mL de azeite liberam 108 kcal. Que fração de 13 mL são 2,6 mL?"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{2,6}{13} = \\dfrac{2,6}{5 \\cdot 2,6} = \\dfrac{1}{5}"
            },
            {
              "t": "texto",
              "html": "Então 2,6 mL liberam 1/5 da energia:"
            },
            {
              "t": "eq",
              "tex": "Q = \\dfrac{108}{5} = 21,6\\ \\text{kcal}"
            }
          ]
        },
        {
          "titulo": "O aquecimento da água",
          "blocos": [
            {
              "t": "texto",
              "html": "Todo esse calor vai para a água. Calor sensível:"
            },
            {
              "t": "eq",
              "tex": "Q = m\\, c\\, \\Delta\\theta"
            },
            {
              "t": "texto",
              "html": "Com m = 500 g = 0,5 kg e c = 1 kcal/(kg · ºC):"
            },
            {
              "t": "eq",
              "tex": "21,6 = \\marca{m}{0,5 \\cdot 1} \\cdot \\Delta\\theta"
            },
            {
              "t": "eq",
              "tex": "\\Delta\\theta = \\dfrac{21,6}{\\marca{m}{0,5 \\cdot 1}} = 43,2\\ ^{\\circ}\\text{C}",
              "mover": [
                "m"
              ]
            }
          ]
        },
        {
          "titulo": "A temperatura final",
          "blocos": [
            {
              "t": "texto",
              "html": "A água partiu de 20,0 ºC:"
            },
            {
              "t": "eq",
              "tex": "\\theta = 20,0 + 43,2 = 63,2\\ ^{\\circ}\\text{C}"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
