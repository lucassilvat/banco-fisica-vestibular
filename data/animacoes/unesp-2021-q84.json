      "titulo": "Resolução",
      "blocos": [
        {
          "t": "texto",
          "html": "Há dois caminhos:"
        },
        {
          "t": "texto",
          "html": "1) Converter a velocidade do VANT para <b>m/s</b>."
        },
        {
          "t": "texto",
          "html": "2) Converter a velocidade do som para <b>km/h</b>."
        },
        {
          "t": "texto",
          "html": "Escolha um método nas abas acima, ou avance para ver os dois."
        }
      ]
    }
  ],
  "metodos": [
    {
      "nome": "Em metros por segundo",
      "telas": [
        {
          "titulo": "Convertendo a velocidade do VANT",
          "blocos": [
            {
              "t": "texto",
              "html": "Pelo quadro, o VANT 14-X atinge <b>12 000 km/h</b>. Pelo texto, Mach 5 = 1 700 m/s, então Mach 1 = 340 m/s."
            },
            {
              "t": "eq",
              "tex": "12\\,000\\ \\text{km/h} = \\dfrac{12\\,000}{3,6} \\approx 3\\,333\\ \\text{m/s}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{3\\,333}{340} \\approx 9,8"
            },
            {
              "t": "texto",
              "html": "Aproximadamente <b>Mach 10</b>."
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    },
    {
      "nome": "Em quilômetros por hora",
      "telas": [
        {
          "titulo": "Convertendo a velocidade do som",
          "blocos": [
            {
              "t": "texto",
              "html": "Em vez de converter a velocidade do VANT, convertemos a do som:"
            },
            {
              "t": "eq",
              "tex": "340\\ \\text{m/s} = 340 \\cdot 3,6 = 1\\,224\\ \\text{km/h}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{12\\,000}{1\\,224} \\approx 9,8"
            },
            {
              "t": "texto",
              "html": "Aproximadamente <b>Mach 10</b>."
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
