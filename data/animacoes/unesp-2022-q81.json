  "metodos": [
    {
      "nome": "Frequência constante",
      "telas": [
        {
          "titulo": "O que muda e o que não muda",
          "cena": {
            "mostrar": [
              "fundo",
              "ondas",
              "comprimentos"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Na refração, a <b>frequência não muda</b>: quem a impõe é a fonte."
            },
            {
              "t": "texto",
              "html": "Muda a velocidade, que depende da profundidade: v = √(g h)."
            }
          ]
        },
        {
          "titulo": "A razão das velocidades",
          "cena": {
            "mostrar": [
              "fundo",
              "ondas",
              "comprimentos"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A razão das velocidades; g aparece nas duas e <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{v_{2}}{v_{1}} = \\dfrac{\\sqrt{\\marca{a}{g} \\cdot 0,9}}{\\sqrt{\\marca{b}{g} \\cdot 3,6}}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{v_{2}}{v_{1}} = \\sqrt{\\dfrac{0,9}{3,6}} = \\sqrt{\\dfrac{1}{4}} = \\dfrac{1}{2}",
              "cancelar": [
                "a",
                "b"
              ]
            }
          ]
        },
        {
          "titulo": "O novo comprimento de onda",
          "cena": {
            "mostrar": [
              "fundo",
              "ondas",
              "comprimentos"
            ],
            "destacar": [
              "comprimentos"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Com v = λf e a <b>mesma frequência</b>, f cancela:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{v_{2}}{v_{1}} = \\dfrac{\\lambda_{2}\\, \\marca{c}{f}}{\\lambda_{1}\\, \\marca{d}{f}}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{\\lambda_{2}}{\\lambda_{1}} = \\dfrac{1}{2}",
              "cancelar": [
                "c",
                "d"
              ]
            },
            {
              "t": "eq",
              "tex": "\\lambda_{2} = \\dfrac{12}{2} = 6\\ \\text{m}"
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
