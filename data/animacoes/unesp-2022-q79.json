            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Calor para aquecer a peça de 20 ºC a 80 ºC:"
            },
            {
              "t": "eq",
              "tex": "Q = m c\\, \\Delta\\theta = 200 \\cdot 0,03 \\cdot 60"
            },
            {
              "t": "eq",
              "tex": "Q = 360\\ \\text{cal} = 360 \\cdot 4 = 1\\,440\\ \\text{J}"
            }
          ]
        },
        {
          "titulo": "O tempo",
          "cena": {
            "mostrar": [
              "grafico",
              "area"
            ],
            "destacar": [
              "area"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Pelo gráfico, a peça absorve energia a uma potência constante de <b>2 W</b>. Isolamos o tempo:"
            },
            {
              "t": "eq",
              "tex": "Q = \\marca{p}{P}\\, \\Delta t"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = \\dfrac{Q}{\\marca{p}{P}}",
              "mover": [
                "p"
              ]
            },
            {
              "t": "eq",
              "tex": "\\Delta t = \\dfrac{1\\,440}{2} = 720\\ \\text{s}"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = 12\\ \\text{min}"
            },
