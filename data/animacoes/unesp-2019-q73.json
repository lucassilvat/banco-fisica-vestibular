{
  "id": "unesp-2019-q73",
  "formato": "aula",
  "titulo": "Do tempo de voo à massa de CO₂",
  "conceitos": [
    "Velocidade média",
    "Estequiometria"
  ],
  "abertura": [
    {
      "titulo": "Resolução",
      "blocos": [
        {
          "t": "texto",
          "html": "Há três caminhos:"
        },
        {
          "t": "texto",
          "html": "1) Passar o combustível para <b>mols</b> e usar a proporção de 12 mol de CO<sub>2</sub> por mol."
        },
        {
          "t": "texto",
          "html": "2) Usar a <b>proporção em massa</b>: quantos gramas de CO<sub>2</sub> cada grama de combustível gera."
        },
        {
          "t": "texto",
          "html": "3) A mesma proporção em massa, com os valores <b>aproximados</b>, como se faz na hora da prova."
        },
        {
          "t": "texto",
          "html": "Escolha um método nas abas acima, ou avance para ver os três."
        }
      ]
    }
  ],
  "metodos": [
    {
      "nome": "Em mols",
      "telas": [
        {
          "titulo": "O combustível",
          "blocos": [
            {
              "t": "texto",
              "html": "Tempo de voo e combustível, em cruzeiro:"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = \\dfrac{2\\,400}{800} = 3\\ \\text{h}"
            },
            {
              "t": "eq",
              "tex": "3 \\cdot 2\\,200 = 6\\,600\\ \\text{kg de QAV}"
            },
            {
              "t": "texto",
              "html": "Em mols de C<sub>12</sub>H<sub>26</sub> (170 g/mol):"
            },
            {
              "t": "eq",
              "tex": "n = \\dfrac{6,6 \\cdot 10^{6}}{170} \\approx 3,9 \\cdot 10^{4}\\ \\text{mol}"
            }
          ]
        },
        {
          "titulo": "A massa de CO₂",
          "blocos": [
            {
              "t": "texto",
              "html": "Cada mol de C<sub>12</sub>H<sub>26</sub> gera <b>12 mol</b> de CO<sub>2</sub> (44 g/mol):"
            },
            {
              "t": "eq",
              "tex": "n_{\\text{CO}_{2}} = 12 \\cdot 3,9 \\cdot 10^{4} \\approx 4,66 \\cdot 10^{5}\\ \\text{mol}"
            },
            {
              "t": "eq",
              "tex": "m = 4,66 \\cdot 10^{5} \\cdot 44 \\approx 2,05 \\cdot 10^{7}\\ \\text{g}"
            },
            {
              "t": "eq",
              "tex": "m \\approx 20\\ \\text{t}"
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    },
    {
      "nome": "Proporção em massa",
      "telas": [
        {
          "titulo": "Quantas vezes a massa do combustível",
          "blocos": [
            {
              "t": "texto",
              "html": "O voo dura 2 400/800 = 3 h e consome 3 · 2 200 = <b>6 600 kg</b> de QAV."
            },
            {
              "t": "texto",
              "html": "Cada 170 g de C<sub>12</sub>H<sub>26</sub> gera 12 · 44 = 528 g de CO<sub>2</sub>:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{528}{170} \\approx 3,1"
            },
            {
              "t": "texto",
              "html": "A massa de CO<sub>2</sub> é cerca de 3,1 vezes a de combustível:"
            },
            {
              "t": "eq",
              "tex": "m \\approx 3,1 \\cdot 6\\,600\\ \\text{kg} \\approx 20\\,500\\ \\text{kg} \\approx 20\\ \\text{t}"
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    },
    {
      "nome": "Aproximando",
      "telas": [
        {
          "titulo": "Arredondando a proporção",
          "blocos": [
            {
              "t": "texto",
              "html": "Na hora da prova, dá para arredondar sem medo: as alternativas estão bem separadas."
            },
            {
              "t": "texto",
              "html": "Combustível: 3 h · 2 200 kg/h = <b>6 600 kg</b>."
            },
            {
              "t": "texto",
              "html": "Cada 170 g de combustível gera 528 g de CO<sub>2</sub>. Arredondando 528 para 510 = 3 · 170:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{528}{170} \\approx \\dfrac{510}{170} = 3"
            }
          ]
        },
        {
          "titulo": "O mesmo gabarito",
          "blocos": [
            {
              "t": "texto",
              "html": "A massa de CO<sub>2</sub> é cerca de <b>3 vezes</b> a de combustível:"
            },
            {
              "t": "eq",
              "tex": "m \\approx 3 \\cdot 6\\,600\\ \\text{kg} = 19\\,800\\ \\text{kg} \\approx 20\\ \\text{t}"
            },
            {
              "t": "texto",
              "html": "O mesmo resultado das contas completas (cerca de 20,5 t): a alternativa não muda."
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
