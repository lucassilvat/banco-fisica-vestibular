{
  "id": "unesp-2019-q80",
  "formato": "aula",
  "titulo": "Três meias-vidas térmicas da panela",
  "conceitos": [
    "Meia-vida térmica",
    "Calor sensível"
  ],
  "metodos": [
    {
      "nome": "Meia-vida por meia-vida",
      "telas": [
        {
          "titulo": "A 1ª meia-vida",
          "blocos": [
            {
              "t": "texto",
              "html": "Pela definição, em cada meia-vida térmica a <b>diferença</b> entre a temperatura da panela e a do ambiente (30 ºC) cai para a metade."
            },
            {
              "t": "texto",
              "html": "<b>1ª meia-vida.</b> No início, a panela está a 110 ºC:"
            },
            {
              "t": "eq",
              "tex": "110 - 30 = 80\\ ^{\\circ}\\text{C}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{80}{2} = 40\\ ^{\\circ}\\text{C} \\quad \\Rightarrow \\quad T = 30 + 40 = 70\\ ^{\\circ}\\text{C}"
            },
            {
              "t": "texto",
              "html": "A panela vai de <b>110 ºC a 70 ºC</b>."
            }
          ]
        },
        {
          "titulo": "A 2ª e a 3ª meias-vidas",
          "blocos": [
            {
              "t": "texto",
              "html": "<b>2ª meia-vida.</b> Começa a 70 ºC, com diferença de 40 ºC:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{40}{2} = 20\\ ^{\\circ}\\text{C} \\quad \\Rightarrow \\quad T = 30 + 20 = 50\\ ^{\\circ}\\text{C}"
            },
            {
              "t": "texto",
              "html": "De <b>70 ºC a 50 ºC</b>."
            },
            {
              "t": "texto",
              "html": "<b>3ª meia-vida.</b> Começa a 50 ºC, com diferença de 20 ºC:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{20}{2} = 10\\ ^{\\circ}\\text{C} \\quad \\Rightarrow \\quad T = 30 + 10 = 40\\ ^{\\circ}\\text{C}"
            },
            {
              "t": "texto",
              "html": "De <b>50 ºC a 40 ºC</b>. Depois das três meias-vidas, a panela está a <b>40 ºC</b>."
            }
          ]
        },
        {
          "titulo": "O calor cedido",
          "blocos": [
            {
              "t": "texto",
              "html": "A panela esfriou de 110 ºC para 40 ºC:"
            },
            {
              "t": "eq",
              "tex": "\\Delta T = 40 - 110 = -70\\ ^{\\circ}\\text{C}"
            },
            {
              "t": "texto",
              "html": "Calor sensível, com m = 2 kg = 2 000 g:"
            },
            {
              "t": "eq",
              "tex": "Q = m\\, c\\, \\Delta T"
            },
            {
              "t": "eq",
              "tex": "Q = 2\\,000 \\cdot 0,1 \\cdot (-70) = -14\\,000\\ \\text{cal}"
            },
            {
              "t": "texto",
              "html": "O sinal negativo indica calor <b>cedido</b>: a panela cede <b>14 000 cal</b> ao ambiente."
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
