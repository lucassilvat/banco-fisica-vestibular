{
  "id": "unesp-2025-q79",
  "formato": "aula",
  "titulo": "Do desnível do mercúrio à temperatura",
  "conceitos": [
    "Manômetro",
    "Equação de Clapeyron"
  ],
  "cena": {
    "modelo": "manometro-gas",
    "parametros": {}
  },
  "metodos": [
    {
      "nome": "Pressão e Clapeyron",
      "telas": [
        {
          "titulo": "A pressão do gás",
          "cena": {
            "mostrar": [
              "recipiente",
              "gas",
              "mercurio",
              "patm",
              "desnivel"
            ],
            "destacar": [
              "desnivel"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O ramo aberto, sob a pressão atmosférica, está <b>152 mm mais alto</b>: o gás empurra o mercúrio com pressão <b>maior</b> que a atmosférica."
            },
            {
              "t": "eq",
              "tex": "p = p_{\\text{atm}} + 152\\ \\text{mmHg}"
            },
            {
              "t": "texto",
              "html": "Repare que 152 = 0,2 · 760:"
            },
            {
              "t": "eq",
              "tex": "p = 760 + 0,2 \\cdot 760 = 1,2 \\cdot 760\\ \\text{mmHg}"
            },
            {
              "t": "texto",
              "html": "Como 760 mmHg = 10<sup>5</sup> Pa:"
            },
            {
              "t": "eq",
              "tex": "p = 1,2 \\cdot 10^{5}\\ \\text{Pa}"
            }
          ]
        },
        {
          "titulo": "A temperatura",
          "cena": {
            "mostrar": [
              "recipiente",
              "gas",
              "mercurio",
              "patm",
              "desnivel",
              "pressoes"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Equação de <b>Clapeyron</b>; isolamos T, e nR <b>passa para o outro lado</b>, dividindo:"
            },
            {
              "t": "eq",
              "tex": "p V = \\marca{n}{n R}\\, T"
            },
            {
              "t": "eq",
              "tex": "T = \\dfrac{p V}{\\marca{n}{n R}}",
              "mover": [
                "n"
              ]
            },
            {
              "t": "eq",
              "tex": "T = \\dfrac{1,2 \\cdot 10^{5} \\cdot 6 \\cdot 10^{-3}}{0,25 \\cdot 8}"
            },
            {
              "t": "texto",
              "html": "No denominador, 0,25 · 8 = 2, que simplifica com o 6:"
            },
            {
              "t": "eq",
              "tex": "T = \\dfrac{1,2 \\cdot 10^{5} \\cdot \\marca{a}{6} \\cdot 10^{-3}}{\\marca{b}{2}}"
            },
            {
              "t": "eq",
              "tex": "T = 1,2 \\cdot 3 \\cdot 10^{2}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "eq",
              "tex": "T = 360\\ \\text{K}"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00",
