  "metodos": [
    {
      "nome": "A lupa",
      "telas": [
        {
          "titulo": "Que imagem é essa",
          "cena": {
            "mostrar": [
              "lente",
              "objeto"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A imagem é <b>direita</b> e <b>maior</b> que o objeto. Para objeto real, imagem direita numa lente é <b>virtual</b>."
            },
            {
              "t": "texto",
              "html": "Lente divergente só forma imagem virtual, direita e <b>menor</b>: (b) e (d) estão fora. A lente é <b>convergente</b>."
            }
          ]
        },
        {
          "titulo": "Os raios",
          "cena": {
            "mostrar": [
              "lente",
              "objeto",
              "raios",
              "imagem"
            ],
            "destacar": [
              "imagem"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Na lente convergente, a imagem é direita e ampliada só com o objeto <b>entre o foco e a lente</b>: é a lupa."
            },
            {
              "t": "texto",
              "html": "Um raio paralelo ao eixo refrata passando por F'; o raio pelo centro da lente não desvia. Os dois saem divergentes, e seus <b>prolongamentos</b> se cruzam do mesmo lado do objeto: lá está a imagem."
            }
          ]
        },
        {
          "titulo": "Onde fica o objeto",
          "cena": {
            "mostrar": [
              "lente",
              "objeto",
              "raios",
              "imagem",
              "distancias"
            ],
            "destacar": [
              "distancias"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A distância d entre o objeto e a lente é <b>menor</b> que a distância focal f. Se fosse maior, a imagem seria real e invertida: (c) está fora."
            },
            {
              "t": "gabarito",
              "letra": "a"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
