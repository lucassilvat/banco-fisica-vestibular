          "titulo": "A potência solar que chega",
          "blocos": [
            {
              "t": "texto",
              "html": "A intensidade é a potência por unidade de área:"
            },
            {
              "t": "eq",
              "tex": "I = \\dfrac{P_{\\text{inc}}}{\\marca{a}{A}}"
            },
            {
              "t": "eq",
              "tex": "P_{\\text{inc}} = I \\cdot \\marca{a}{A}",
              "mover": [
                "a"
              ]
            },
            {
              "t": "eq",
              "tex": "P_{\\text{inc}} = 924 \\cdot 2,5 = 2\\,310\\ \\text{W}"
            }
          ]
        },
        {
          "titulo": "A eficiência",
          "blocos": [
            {
              "t": "texto",
              "html": "No mesmo intervalo de tempo, a razão entre as energias é a razão entre as potências:"
            },
            {
              "t": "eq",
              "tex": "\\eta = \\dfrac{P_{\\text{útil}}}{P_{\\text{inc}}} = \\dfrac{462}{2\\,310}"
            },
            {
              "t": "texto",
              "html": "Como 2 310 = 5 · 462:"
            },
            {
              "t": "eq",
              "tex": "\\eta = \\dfrac{\\marca{a}{462}}{5 \\cdot \\marca{b}{462}}"
            },
            {
              "t": "eq",
              "tex": "\\eta = \\dfrac{1}{5} = 0,20 = 20\\ \\%",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "gabarito",
              "letra": "b"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
