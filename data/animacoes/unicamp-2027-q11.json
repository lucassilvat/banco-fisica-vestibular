  "metodos": [
    {
      "nome": "Atrito cinético",
      "telas": [
        {
          "titulo": "Qual atrito",
          "cena": {
            "mostrar": [
              "pista",
              "disco",
              "velocidade",
              "forcas",
              "atrito"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O disco está <b>deslizando</b> sobre o gelo: o atrito é <b>cinético</b>. O coeficiente estático (0,1) não entra na conta."
            },
            {
              "t": "texto",
              "html": "Sobre o disco agem o peso \\(\\vec{P}\\), a normal \\(\\vec{N}\\) e o atrito \\(\\vec{f}_{at}\\), contrário ao deslizamento."
            }
          ]
        },
        {
          "titulo": "A normal",
          "cena": {
            "mostrar": [
              "pista",
              "disco",
              "velocidade",
              "forcas",
              "atrito"
            ],
            "destacar": [
              "forcas"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Pista horizontal: na vertical não há movimento, a normal equilibra o peso."
            },
            {
              "t": "eq",
              "tex": "N = P = m\\, g"
            },
            {
              "t": "eq",
              "tex": "N = 20 \\cdot 10 = 200\\ \\text{N}"
            }
          ]
        },
        {
          "titulo": "A força de atrito",
          "cena": {
            "mostrar": [
              "pista",
              "disco",
              "velocidade",
              "forcas",
              "atrito"
            ],
            "destacar": [
              "atrito"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Força de atrito cinético:"
            },
            {
              "t": "eq",
              "tex": "f_{at} = \\mu_{C}\\, N"
            },
            {
              "t": "eq",
              "tex": "f_{at} = 0,02 \\cdot 200 = 4,0\\ \\text{N}"
            },
            {
              "t": "texto",
              "html": "Com o coeficiente estático, por engano, daria 20 N (alternativa d)."
            },
            {
              "t": "gabarito",
              "letra": "c"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
