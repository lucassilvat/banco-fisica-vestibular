{
  "id": "unesp-2022-q82",
  "formato": "aula",
  "titulo": "Mesma energia, potências muito diferentes",
  "conceitos": [
    "Energia elétrica",
    "Potência"
  ],
  "abertura": [
    {
      "titulo": "Resolução",
      "blocos": [
        {
          "t": "texto",
          "html": "Há dois caminhos:"
        },
        {
          "t": "texto",
          "html": "1) Calcular a <b>energia</b> do banho e dividir pela potência da lâmpada."
        },
        {
          "t": "texto",
          "html": "2) Comparar as <b>potências</b>: quantas vezes a lâmpada consome menos."
        },
        {
          "t": "texto",
          "html": "Escolha um método nas abas acima, ou avance para ver os dois."
        }
      ]
    }
  ],
  "metodos": [
    {
      "nome": "Pela energia",
      "telas": [
        {
          "titulo": "A energia do banho",
          "blocos": [
            {
              "t": "texto",
              "html": "Pelas embalagens: chuveiro de <b>7 500 W</b> e lâmpada de <b>20 W</b>."
            },
            {
              "t": "texto",
              "html": "Energia do banho de 12 min = 0,2 h:"
            },
            {
              "t": "eq",
              "tex": "E = 7\\,500 \\cdot 0,2 = 1\\,500\\ \\text{Wh}"
            },
            {
              "t": "texto",
              "html": "A lâmpada precisa consumir a mesma energia:"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = \\dfrac{E}{P} = \\dfrac{1\\,500}{20}"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = 75\\ \\text{h}"
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    },
    {
      "nome": "Pela razão das potências",
      "telas": [
        {
          "titulo": "Quantas vezes mais tempo",
          "blocos": [
            {
              "t": "texto",
              "html": "Mesma energia: potência vezes tempo é igual para os dois aparelhos."
            },
            {
              "t": "eq",
              "tex": "P_{\\text{ch}}\\, \\Delta t_{\\text{ch}} = P_{\\text{l}}\\, \\Delta t_{\\text{l}}"
            },
            {
              "t": "eq",
              "tex": "\\Delta t_{\\text{l}} = \\dfrac{7\\,500}{20} \\cdot 12\\ \\text{min}"
            },
            {
              "t": "texto",
              "html": "A lâmpada tem potência 375 vezes menor: precisa ficar acesa 375 vezes mais."
            },
            {
              "t": "eq",
              "tex": "\\Delta t_{\\text{l}} = 375 \\cdot 12 = 4\\,500\\ \\text{min}"
            },
            {
              "t": "eq",
              "tex": "\\Delta t_{\\text{l}} = \\dfrac{4\\,500}{60} = 75\\ \\text{h}"
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
