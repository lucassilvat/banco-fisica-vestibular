{
  "id": "unesp-2025-q84",
  "formato": "aula",
  "titulo": "O erro da fórmula rápida",
  "conceitos": [
    "Função modular",
    "Escalas termométricas"
  ],
  "cena": {
    "modelo": "grafico-modulo",
    "parametros": {
      "zero": 50,
      "coef": 0.05555555555555555,
      "xs": [
        -20,
        130
      ],
      "ys": [
        -4,
        5
      ],
      "marcasX": [
        50
      ],
      "rotX": "T_{F}",
      "rotY": "E(T_{F})",
      "rotReta": "(T_{F} − 50)/18",
      "rotModulo": "E = |T_{F} − 50|/18",
      "rotPonto0": "25/9"
    }
  },
  "metodos": [
    {
      "nome": "Diferença e módulo",
      "telas": [
        {
          "titulo": "A diferença entre as fórmulas",
          "cena": {
            "mostrar": [
              "eixos",
              "reta"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Começamos pela diferença entre as duas fórmulas:"
            },
            {
              "t": "eq",
              "tex": "T_{C} - T^{*}_{C} = \\dfrac{5(T_{F} - 32)}{9} - \\dfrac{T_{F} - 30}{2}"
            },
            {
              "t": "texto",
              "html": "Com denominador comum 18:"
            },
            {
              "t": "eq",
              "tex": "T_{C} - T^{*}_{C} = \\dfrac{10(T_{F} - 32) - 9(T_{F} - 30)}{18}"
            },
            {
              "t": "eq",
              "tex": "T_{C} - T^{*}_{C} = \\dfrac{10T_{F} - 320 - 9T_{F} + 270}{18}"
            },
            {
              "t": "eq",
              "tex": "T_{C} - T^{*}_{C} = \\dfrac{T_{F} - 50}{18}"
            },
            {
              "t": "texto",
              "html": "É uma <b>reta</b>, que se anula em T<sub>F</sub> = 50."
            }
          ]
        },
        {
          "titulo": "O módulo",
          "cena": {
            "mostrar": [
              "eixos",
              "reta",
              "modulo",
              "ponto-zero"
            ],
            "estado": {
              "dobrar": true
            }
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O erro é o <b>módulo</b> dessa diferença: a parte negativa da reta é <b>rebatida</b> para cima, e o gráfico vira um <b>V</b>."
            },
            {
              "t": "eq",
              "tex": "E(T_{F}) = \\dfrac{|T_{F} - 50|}{18}"
            },
            {
              "t": "texto",
              "html": "O vértice, onde o erro é nulo, fica em T<sub>F</sub> = 50."
            }
          ]
        },
        {
          "titulo": "O valor em 0 °F",
          "cena": {
            "mostrar": [
              "eixos",
              "reta",
              "modulo",
              "ponto-zero",
              "ponto-0"
            ],
            "estado": {
              "dobrar": false
            },
            "destacar": [
              "ponto-0"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Para identificar o gráfico, o valor em T<sub>F</sub> = 0:"
            },
            {
              "t": "eq",
              "tex": "E(0) = \\dfrac{50}{18} = \\dfrac{\\marca{a}{2} \\cdot 25}{\\marca{b}{2} \\cdot 9}"
            },
            {
              "t": "eq",
              "tex": "E(0) = \\dfrac{25}{9}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "texto",
              "html": "O gráfico em V com zero em 50 e valor 25/9 em T<sub>F</sub> = 0 é o da alternativa B."
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
