  "metodos": [
    {
      "nome": "Imagem de imagem",
      "telas": [
        {
          "titulo": "A primeira imagem",
          "cena": {
            "mostrar": [
              "cena",
              "imagem-1"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Chame de E<sub>1</sub> o espelho à frente do cliente (a 1 m) e de E<sub>2</sub> o espelho atrás dele (a 3 − 1 = 2 m). A seta azul marca a cabeça do cliente."
            },
            {
              "t": "texto",
              "html": "No espelho plano, a imagem é <b>simétrica</b> ao objeto: a 1ª imagem em E<sub>1</sub> fica 1 m atrás de E<sub>1</sub>. Repare no olho: ela está <b>virada para o cliente</b>; é o rosto de frente."
            }
          ]
        },
        {
          "titulo": "A imagem em E₂",
          "cena": {
            "mostrar": [
              "cena",
              "imagem-1",
              "imagem-e2"
            ],
            "destacar": [
              "imagem-e2"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "E<sub>2</sub> também forma uma imagem do cliente, 2 m atrás de E<sub>2</sub>. O cliente está de costas para E<sub>2</sub>: nessa imagem, o olho aponta para <b>longe</b> dos espelhos; ela mostra a nuca."
            },
            {
              "t": "texto",
              "html": "A distância dessa imagem até E<sub>1</sub>:"
            },
            {
              "t": "eq",
              "tex": "2 + 3 = 5\\ \\text{m}"
            }
          ]
        },
        {
          "titulo": "A imagem dessa imagem",
          "cena": {
            "mostrar": [
              "cena",
              "imagem-1",
              "imagem-e2",
              "imagem-pedida"
            ],
            "destacar": [
              "imagem-pedida"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "E<sub>1</sub> forma a imagem dessa imagem, 5 m atrás de E<sub>1</sub>. Ela fica <b>de costas</b> para o cliente: é a cabeça indicada pela seta vermelha."
            },
            {
              "t": "texto",
              "html": "Até o cliente, que está 1 m à frente de E<sub>1</sub>:"
            },
            {
              "t": "eq",
              "tex": "d = 1 + 5 = 6\\ \\text{m}"
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
