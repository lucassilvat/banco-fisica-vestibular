  "metodos": [
    {
      "nome": "Imagem de imagem",
      "telas": [
        {
          "titulo": "A primeira imagem",
          "cena": {
            "mostrar": [
              "cena",
              "imagem-1"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Chame de E<sub>1</sub> o espelho à frente do cliente (a 1 m) e de E<sub>2</sub> o espelho atrás dele (a 3 − 1 = 2 m)."
            },
            {
              "t": "texto",
              "html": "No espelho plano, a imagem é <b>simétrica</b> ao objeto. A primeira imagem em E<sub>1</sub> fica 1 m atrás dele: é o rosto de frente."
            }
          ]
        },
        {
          "titulo": "A imagem em E₂",
          "cena": {
            "mostrar": [
              "cena",
              "imagem-1",
              "imagem-e2"
            ],
            "destacar": [
              "imagem-e2"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A seta vermelha é a imagem seguinte, a cabeça de costas. Ela vem da imagem formada por E<sub>2</sub>, 2 m atrás de E<sub>2</sub>. A distância dela até E<sub>1</sub>:"
            },
            {
              "t": "eq",
              "tex": "2 + 3 = 5\\ \\text{m}"
            }
          ]
        },
        {
          "titulo": "A imagem dessa imagem",
          "cena": {
            "mostrar": [
              "cena",
              "imagem-1",
              "imagem-e2",
              "imagem-pedida"
            ],
            "destacar": [
              "imagem-pedida"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "E<sub>1</sub> reflete essa imagem: ela fica 5 m atrás de E<sub>1</sub>. Até o cliente, que está 1 m à frente de E<sub>1</sub>:"
            },
            {
              "t": "eq",
              "tex": "d = 1 + 5 = 6\\ \\text{m}"
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
