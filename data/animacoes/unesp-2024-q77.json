            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "As quatro forças que B<sub>2</sub> exerce em B<sub>1</sub> têm a <b>mesma direção</b>. F<sub>1</sub> e F<sub>4</sub> (atrações) apontam para a direita; F<sub>2</sub> e F<sub>3</sub> (repulsões), para a esquerda."
            },
            {
              "t": "eq",
              "tex": "F_{R} = F_{1} + F_{4} - F_{2} - F_{3}"
            },
