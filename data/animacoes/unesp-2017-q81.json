  "metodos": [
    {
      "nome": "Radar e sonar",
      "telas": [
        {
          "titulo": "O que cada onda é",
          "cena": {
            "mostrar": [
              "tabela"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O radar usa ondas de <b>rádio</b>: eletromagnéticas e transversais, que se propagam até no vácuo, a cerca de 3 · 10<sup>8</sup> m/s."
            },
            {
              "t": "texto",
              "html": "O sonar usa <b>som</b>: onda mecânica, longitudinal na água, que precisa de um meio material, a cerca de 1 500 m/s na água."
            }
          ]
        },
        {
          "titulo": "As alternativas falsas",
          "cena": {
            "mostrar": [
              "tabela"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "<b>(A) Falsa:</b> é o contrário."
            },
            {
              "t": "texto",
              "html": "<b>(B) Falsa:</b> a onda de rádio não precisa de meio; e o som, em geral, é mais rápido em meios mais densos."
            },
            {
              "t": "texto",
              "html": "<b>(C) Falsa:</b> a onda de rádio é transversal; o som na água é longitudinal."
            },
            {
              "t": "texto",
              "html": "<b>(E) Falsa:</b> a onda de rádio no ar é muito mais rápida que o som na água."
            }
          ]
        },
