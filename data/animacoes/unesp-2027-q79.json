  "metodos": [
    {
      "nome": "Leitura do gráfico e potência",
      "telas": [
        {
          "titulo": "A leitura do gráfico",
          "cena": {
            "mostrar": [
              "grafico",
              "leitura"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O gráfico dá a temperatura da água para cada quantidade de calor absorvido."
            },
            {
              "t": "texto",
              "html": "A água está a <b>40 ºC</b> quando Q = 24 · 10<sup>4</sup> J e a <b>60 ºC</b> quando Q = 48 · 10<sup>4</sup> J."
            },
            {
              "t": "texto",
              "html": "O calor absorvido entre essas duas temperaturas é a diferença:"
            },
            {
              "t": "eq",
              "tex": "\\Delta Q = 48 \\cdot 10^{4} - 24 \\cdot 10^{4} = 24 \\cdot 10^{4}\\ \\text{J}"
            }
          ]
        },
        {
          "titulo": "A potência",
          "cena": {
            "mostrar": [
              "grafico",
              "leitura"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Potência é a energia transferida por unidade de tempo:"
            },
            {
              "t": "eq",
              "tex": "P = \\dfrac{\\Delta Q}{\\marca{t}{\\Delta t}}"
            },
            {
              "t": "texto",
              "html": "Isolando o intervalo de tempo:"
            },
            {
              "t": "eq",
              "tex": "\\marca{t}{\\Delta t} = \\dfrac{\\Delta Q}{P}",
              "mover": [
                "t"
              ]
            },
            {
              "t": "eq",
              "tex": "\\Delta t = \\dfrac{24 \\cdot 10^{4}}{2\\,000}"
            },
            {
              "t": "texto",
              "html": "Escrevendo 24 = 2 · 12 e 2 000 = 2 · 10<sup>3</sup>, o 2 <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = \\dfrac{\\marca{a}{2} \\cdot 12 \\cdot 10^{4}}{\\marca{b}{2} \\cdot 10^{3}}"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = 12 \\cdot 10 = 120\\ \\text{s}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "texto",
              "html": "Como 1 min = 60 s, 120 s = <b>2,00 min</b>."
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
