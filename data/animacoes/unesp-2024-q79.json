  "metodos": [
    {
      "nome": "Índice de refração",
      "telas": [
        {
          "titulo": "Lendo o gráfico",
          "cena": {
            "mostrar": [
              "grafico",
              "leitura"
            ],
            "destacar": [
              "leitura"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "No gráfico, a solução de <b>40 ºBx</b> tem índice de refração:"
            },
            {
              "t": "eq",
              "tex": "n \\approx 1,40"
            }
          ]
        },
        {
          "titulo": "A velocidade na solução",
          "cena": {
            "mostrar": [
              "grafico",
              "leitura"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O índice de refração absoluto compara a velocidade da luz no vácuo com a velocidade no meio. Isolamos v:"
            },
            {
              "t": "eq",
              "tex": "n = \\dfrac{c}{\\marca{v}{v}}"
            },
            {
              "t": "eq",
              "tex": "\\marca{v}{v} = \\dfrac{c}{n}",
              "mover": [
                "v"
              ]
            },
            {
              "t": "eq",
              "tex": "v = \\dfrac{3 \\cdot 10^{8}}{1,40}"
            },
            {
              "t": "eq",
              "tex": "v \\approx 2,1 \\cdot 10^{8}\\ \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "C"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
