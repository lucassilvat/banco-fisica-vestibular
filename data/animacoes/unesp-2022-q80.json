    {
      "titulo": "Equação de Gauss",
      "conceito": "Equação de Gauss",
      "texto": "Resposta: <b>(D)</b>.",
      "equacoes": [
        "-\\dfrac{2}{\\mathrm{y}} = \\dfrac{1}{\\mathrm{d}} - \\dfrac{1}{\\mathrm{x}} \\quad \\Rightarrow \\quad \\dfrac{1}{\\mathrm{d}} = \\dfrac{\\mathrm{y} - 2\\mathrm{x}}{\\mathrm{x} \\cdot \\mathrm{y}} \\quad \\Rightarrow \\quad \\mathrm{d} = \\dfrac{\\mathrm{x} \\cdot \\mathrm{y}}{\\mathrm{y} - 2 \\cdot \\mathrm{x}}"
      ],
