  "metodos": [
    {
      "nome": "Equação de Gauss com letras",
      "telas": [
        {
          "titulo": "O que a figura informa",
          "cena": {
            "mostrar": [
              "eixo",
              "objeto",
              "raio",
              "imagem",
              "cotas"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Pela figura, y vai do vértice ao centro de curvatura: o <b>raio de curvatura</b> é y. Espelho <b>convexo</b>: foco negativo."
            },
            {
              "t": "eq",
              "tex": "f = -\\dfrac{y}{2}"
            },
            {
              "t": "texto",
              "html": "A imagem A’ é <b>virtual</b>, a x do vértice, e o objeto está a d:"
            },
            {
              "t": "eq",
              "tex": "p' = -x, \\quad p = d"
            }
          ]
        },
        {
          "titulo": "Equação de Gauss",
          "cena": {
            "mostrar": [
              "eixo",
              "objeto",
              "raio",
              "imagem",
              "cotas"
            ],
            "destacar": [
              "cotas"
            ]
          },
          "blocos": [
            {
              "t": "eq",
              "tex": "\\dfrac{1}{f} = \\dfrac{1}{p} + \\dfrac{1}{p'}"
            },
            {
              "t": "eq",
              "tex": "-\\dfrac{2}{y} = \\dfrac{1}{d} \\marca{x}{- \\dfrac{1}{x}}"
            },
            {
              "t": "texto",
              "html": "Isolamos 1/d: o termo de x <b>passa para o outro lado</b>, somando."
            },
            {
              "t": "eq",
              "tex": "\\marca{x}{\\dfrac{1}{x}} - \\dfrac{2}{y} = \\dfrac{1}{d}",
              "mover": [
                "x"
              ]
            },
            {
              "t": "eq",
              "tex": "\\dfrac{1}{d} = \\dfrac{y - 2x}{x y}"
            },
            {
              "t": "eq",
              "tex": "d = \\dfrac{x \\cdot y}{y - 2 \\cdot x}"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
