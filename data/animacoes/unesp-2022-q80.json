  "passos": [
    {
      "titulo": "O que a figura informa",
      "conceito": "Espelho esférico convexo",
      "texto": "y é a distância do vértice ao centro de curvatura: o raio. A imagem A′ é virtual, atrás do espelho, a uma distância x do vértice. No espelho convexo, o foco é virtual (f negativo).",
      "equacoes": [
        "f = -\\dfrac{\\mathrm{y}}{2}, \\quad p′ = -\\mathrm{x}, \\quad p = \\mathrm{d}"
      ],
      "cena": {
        "mostrar": [
