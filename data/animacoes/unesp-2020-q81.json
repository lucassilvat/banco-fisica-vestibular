  "metodos": [
    {
      "nome": "Energia do fóton",
      "telas": [
        {
          "titulo": "O comprimento de onda",
          "cena": {
            "mostrar": [
              "espectro"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Juntando E = hf e f = c/λ:"
            },
            {
              "t": "eq",
              "tex": "E = \\dfrac{h c}{\\marca{l}{\\lambda}}"
            },
            {
              "t": "texto",
              "html": "Isolamos λ: ele e E <b>trocam de lugar</b>."
            },
            {
              "t": "eq",
              "tex": "\\marca{l}{\\lambda} = \\dfrac{h c}{E}",
              "mover": [
                "l"
              ]
            },
            {
              "t": "eq",
              "tex": "\\lambda = \\dfrac{6,6 \\cdot 10^{-34} \\cdot 3 \\cdot 10^{8}}{3,96 \\cdot 10^{-19}} = \\dfrac{19,8 \\cdot 10^{-26}}{3,96 \\cdot 10^{-19}}"
            },
            {
              "t": "texto",
              "html": "Como 19,8 = 5 · 3,96:"
            },
            {
              "t": "eq",
              "tex": "\\lambda = 5 \\cdot 10^{-7}\\ \\text{m} = 500\\ \\text{nm}"
            }
          ]
        },
        {
          "titulo": "A cor",
