  "metodos": [
    {
      "nome": "Momentos em relação a O",
      "telas": [
        {
          "titulo": "As forças na barra",
          "cena": {
            "mostrar": [
              "barra",
              "forcas"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "As caixas empurram a barra para baixo com forças de intensidades N<sub>A</sub> e N<sub>B</sub> (3ª lei de Newton). O peso da barra homogênea e a tração do fio atuam em O e não dão momento."
            }
          ]
        },
        {
          "titulo": "Momentos iguais",
          "cena": {
            "mostrar": [
              "barra",
              "forcas",
              "momentos"
            ],
            "destacar": [
              "momentos"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Para a barra não girar, os momentos em relação a O se equilibram:"
            },
            {
              "t": "eq",
              "tex": "N_{A} \\cdot x = N_{B} \\cdot y"
            },
            {
              "t": "texto",
              "html": "Pela matriz dada, o determinante é exatamente essa diferença:"
            },
            {
              "t": "eq",
              "tex": "\\text{det}\\, M = N_{A} \\cdot x - N_{B} \\cdot y = 0"
            },
            {
              "t": "texto",
              "html": "Como det(M<sup>t</sup>) = det M, a condição é <b>det(M<sup>t</sup>) = 0</b>."
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
