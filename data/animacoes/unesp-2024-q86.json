  "abertura": [
    {
      "titulo": "Resolução",
      "blocos": [
        {
          "t": "texto",
          "html": "Há dois caminhos:"
        },
        {
          "t": "texto",
          "html": "1) Calcular com as <b>três placas</b>, cada uma no seu centro."
        },
        {
          "t": "texto",
          "html": "2) <b>Aproveitar</b> o centro de massa (6,8; 4,2) das duas primeiras, que o enunciado já deu."
        },
        {
          "t": "texto",
          "html": "Escolha um método nas abas acima, ou avance para ver os dois."
        }
      ]
    }
