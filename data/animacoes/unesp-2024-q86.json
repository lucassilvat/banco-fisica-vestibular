  "metodos": [
    {
      "nome": "Com as três placas",
      "telas": [
        {
          "titulo": "Os centros das placas",
          "cena": {
            "mostrar": [
              "grafico",
              "placas",
              "centros",
              "circulo"
            ],
            "destacar": [
              "circulo"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Cada placa homogênea tem o centro de massa no seu <b>centro geométrico</b>:"
            },
            {
              "t": "texto",
              "html": "quadrada, 2 kg, em (2, 3); retangular, 3 kg, em (10, 5); circular, 3 kg, em (2, 1)."
            },
            {
              "t": "texto",
              "html": "Massa total: 2 + 3 + 3 = <b>8 kg</b>."
            }
          ]
        },
        {
          "titulo": "O novo centro de massa",
          "cena": {
            "mostrar": [
              "grafico",
              "placas",
              "centros",
              "circulo",
              "novo-c"
            ],
            "destacar": [
              "novo-c"
            ]
          },
          "blocos": [
            {
              "t": "eq",
              "tex": "x_{C} = \\dfrac{2 \\cdot 2 + 3 \\cdot 10 + 3 \\cdot 2}{8} = \\dfrac{40}{8}"
            },
            {
              "t": "eq",
              "tex": "x_{C} = 5"
            },
            {
              "t": "eq",
              "tex": "y_{C} = \\dfrac{2 \\cdot 3 + 3 \\cdot 5 + 3 \\cdot 1}{8} = \\dfrac{24}{8}"
            },
            {
              "t": "eq",
              "tex": "y_{C} = 3"
            },
            {
              "t": "texto",
              "html": "O novo centro de massa é <b>(5; 3)</b>."
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    },
    {
      "nome": "Aproveitando o centro de massa dado",
      "telas": [
        {
          "titulo": "Duas placas viram uma",
          "cena": {
            "mostrar": [
              "grafico",
              "placas",
              "centros",
              "circulo",
              "novo-c"
            ],
            "destacar": [
              "novo-c"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O enunciado já deu o centro de massa das duas primeiras placas: (6,8; 4,2), com massa 2 + 3 = <b>5 kg</b>."
            },
            {
              "t": "texto",
              "html": "Podemos tratá-las como um único corpo nesse ponto e juntar só a placa circular, 3 kg em (2, 1):"
            },
            {
              "t": "eq",
              "tex": "x_{C} = \\dfrac{5 \\cdot 6,8 + 3 \\cdot 2}{5 + 3} = \\dfrac{34 + 6}{8} = 5"
            },
            {
              "t": "eq",
              "tex": "y_{C} = \\dfrac{5 \\cdot 4,2 + 3 \\cdot 1}{5 + 3} = \\dfrac{21 + 3}{8} = 3"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
