  "metodos": [
    {
      "nome": "Segunda lei de Newton",
      "telas": [
        {
          "titulo": "O limite da caixa de baixo",
          "cena": {
            "mostrar": [
              "elevador",
              "caixas",
              "limite"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Com o elevador parado e seis caixas de massa m, o piso empurraria a caixa de baixo com uma força igual ao peso das seis:"
            },
            {
              "t": "eq",
              "tex": "N_{\\text{máx}} = 6\\, m\\, g"
            },
            {
              "t": "texto",
              "html": "Esse é o máximo permitido."
            }
          ]
        },
        {
          "titulo": "As três caixas acelerando",
          "cena": {
            "mostrar": [
              "elevador",
              "caixas",
              "limite",
              "forcas"
            ],
            "destacar": [
              "forcas"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "No conjunto das três caixas agem o peso \\(\\vec{P}\\), de intensidade 3mg, e a normal \\(\\vec{N}\\) do piso. Acelerando para cima, pela 2ª lei de Newton:"
            },
            {
              "t": "eq",
              "tex": "N - 3\\, m\\, g = 3\\, m\\, a"
            },
            {
              "t": "eq",
              "tex": "N = 3\\, m\\, (g + a)"
            }
          ]
        },
        {
          "titulo": "A maior aceleração",
          "cena": {
            "mostrar": [
              "elevador",
              "caixas",
              "limite",
              "forcas"
            ],
            "destacar": [
              "limite"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A condição é N ≤ 6mg:"
            },
            {
              "t": "eq",
              "tex": "3\\, \\marca{m1}{m}\\, (g + a) \\leq 6\\, \\marca{m2}{m}\\, g"
            },
            {
              "t": "eq",
              "tex": "3\\, (g + a) \\leq 6\\, g",
              "cancelar": [
                "m1",
                "m2"
              ]
            },
            {
              "t": "eq",
              "tex": "g + a \\leq 2\\, g"
            },
            {
              "t": "eq",
              "tex": "a \\leq g = 10\\ \\text{m/s}^{2}"
            },
            {
              "t": "gabarito",
              "letra": "C"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
