            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O triângulo está inscrito num semicírculo de diâmetro AC: o ângulo em B é <b>reto</b>."
            },
            {
              "t": "eq",
              "tex": "\\cos A = \\dfrac{AB}{AC} = \\dfrac{2}{4} = \\dfrac{1}{2} \\quad \\Rightarrow \\quad A = 60^{\\circ}"
            }
          ]
        },
        {
          "titulo": "A altura de B",
          "cena": {
            "mostrar": [
              "geometria",
              "angulos",
              "altura"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A altura de B em relação ao solo AC:"
            },
            {
              "t": "eq",
              "tex": "h = AB \\cdot \\sen 60^{\\circ} = \\marca{a}{2} \\cdot \\dfrac{\\sqrt{3}}{\\marca{b}{2}}"
            },
            {
              "t": "eq",
              "tex": "h = \\sqrt{3}\\ \\text{m}",
              "cancelar": [
                "a",
                "b"
              ]
            }
          ]
        },
        {
          "titulo": "A massa",
          "cena": {
            "mostrar": [
              "geometria",
              "angulos",
              "altura"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Energia potencial gravitacional; √3 · √3 = 3:"
            },
            {
              "t": "eq",
              "tex": "342 = m \\cdot 5,7\\sqrt{3} \\cdot \\sqrt{3}"
            },
            {
              "t": "eq",
              "tex": "342 = m \\cdot 17,1"
            },
            {
              "t": "eq",
              "tex": "m = \\dfrac{342}{17,1} = 20\\ \\text{kg}"
            },
