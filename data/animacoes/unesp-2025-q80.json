{
  "id": "unesp-2025-q80",
  "formato": "aula",
  "titulo": "A mesma lapiseira, dois aumentos",
  "conceitos": [
    "Aumento linear transversal"
  ],
  "cena": {
    "modelo": "aumento-linear",
    "parametros": {
      "i1": 1.6,
      "A1": 2,
      "A2": 0.8
    }
  },
  "metodos": [
    {
      "nome": "Pelo tamanho real",
      "telas": [
        {
          "titulo": "A largura real da lapiseira",
          "cena": {
            "mostrar": [
              "imagem-1",
              "objeto"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O <b>aumento linear transversal</b> é o tamanho da imagem dividido pelo tamanho do objeto:"
            },
            {
              "t": "eq",
              "tex": "A = \\dfrac{i}{o}"
            },
            {
              "t": "texto",
              "html": "Na figura 1, a imagem tem 1,6 cm, com A<sub>1</sub> = 2:"
            },
            {
              "t": "eq",
              "tex": "o = \\dfrac{1,6}{2} = 0,8\\ \\text{cm}"
            },
            {
              "t": "texto",
              "html": "Essa é a largura <b>real</b> da lapiseira."
            }
          ]
        },
        {
          "titulo": "A imagem na lente divergente",
          "cena": {
            "mostrar": [
              "imagem-1",
              "objeto",
              "imagem-2"
            ],
            "destacar": [
              "imagem-2"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Na figura 2, a mesma lapiseira, com A<sub>2</sub> = 0,8:"
            },
            {
              "t": "eq",
              "tex": "L = A_{2} \\cdot o = 0,8 \\cdot 0,8"
            },
            {
              "t": "eq",
              "tex": "L = 0,64\\ \\text{cm}"
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
