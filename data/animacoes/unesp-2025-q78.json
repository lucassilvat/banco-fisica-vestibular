{
  "id": "unesp-2025-q78",
  "formato": "aula",
  "titulo": "O limite do atrito estático na esteira",
  "conceitos": [
    "Atrito estático",
    "Plano inclinado",
    "Segunda lei de Newton"
  ],
  "cena": {
    "modelo": "plano-inclinado",
    "parametros": {
      "senTheta": 0.6,
      "cosTheta": 0.8,
      "mu": 0.8,
      "g": 10
    }
  },
  "metodos": [
    {
      "nome": "Segunda lei de Newton",
      "telas": [
        {
          "titulo": "O que a questão pede",
          "cena": {
            "mostrar": [
              "rampa",
              "angulo",
              "caixa"
            ],
            "estado": {
              "movimento": "acelerando"
            }
          },
          "blocos": [
            {
              "t": "texto",
              "html": "No início, a esteira acelera rampa acima, e a caixa acelera <b>junto</b> com ela graças ao <b>atrito estático</b>."
            },
            {
              "t": "texto",
              "html": "Quanto maior a aceleração, maior o atrito necessário. O limite é o atrito estático <b>máximo</b>."
            }
          ]
        },
        {
          "titulo": "As forças sobre a caixa",
          "cena": {
            "mostrar": [
              "rampa",
              "angulo",
              "caixa",
              "peso",
              "normal",
              "atrito",
              "eixos",
              "componentes",
              "angulo-peso"
            ],
            "estado": {
              "movimento": "repouso"
            }
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Sobre a caixa atuam o peso \\(\\vec{P}\\), a normal \\(\\vec{N}\\) e o atrito \\(\\vec{F}_{at}\\), que aponta <b>rampa acima</b>."
            },
            {
              "t": "texto",
              "html": "Perpendicular à rampa não há aceleração: a normal equilibra a componente do peso."
            },
            {
              "t": "eq",
              "tex": "N = m g \\cos\\theta"
            },
            {
              "t": "texto",
              "html": "O atrito estático máximo:"
            },
            {
              "t": "eq",
              "tex": "F_{at} = \\mu N = \\mu\\, m g \\cos\\theta"
            }
          ]
        },
        {
          "titulo": "Ao longo da rampa",
          "cena": {
            "mostrar": [
              "rampa",
              "angulo",
              "caixa",
              "peso",
              "normal",
              "atrito",
              "eixos",
              "componentes",
              "angulo-peso",
              "aceleracao"
            ],
            "estado": {
              "movimento": "repouso"
            },
            "destacar": [
              "aceleracao"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Ao longo da rampa, a <b>segunda lei de Newton</b>:"
            },
            {
              "t": "eq",
              "tex": "F_{at} - m g \\sen\\theta = m a"
            },
            {
              "t": "texto",
              "html": "Com o atrito máximo, a <b>massa</b> aparece em todos os termos e <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "\\mu\\, \\marca{a}{m} g \\cos\\theta - \\marca{b}{m} g \\sen\\theta = \\marca{c}{m}\\, a"
            },
            {
              "t": "eq",
              "tex": "a = g\\,(\\mu \\cos\\theta - \\sen\\theta)",
              "cancelar": [
                "a",
                "b",
                "c"
              ]
            },
            {
              "t": "eq",
              "tex": "a = 10\\,(0,8 \\cdot 0,8 - 0,6)"
            },
            {
              "t": "eq",
              "tex": "a = 10 \\cdot 0,04 = 0,4\\ \\text{m/s}^{2}"
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
