{
  "id": "unesp-2016-q79",
  "formato": "aula",
  "titulo": "Da energia em C de volta ao ponto B",
  "conceitos": [
    "Conservação da energia mecânica",
    "Quantidade de movimento"
  ],
  "metodos": [
    {
      "nome": "Energia e quantidade de movimento",
      "telas": [
        {
          "titulo": "A energia em C",
          "blocos": [
            {
              "t": "texto",
              "html": "Tomamos o nível de B como referência. C está 3 m + 5 m acima: h = 8 m."
            },
            {
              "t": "texto",
              "html": "Energia mecânica em C:"
            },
            {
              "t": "eq",
              "tex": "E_{C} = \\dfrac{m\\, v^{2}}{2} + m\\, g\\, h"
            },
            {
              "t": "eq",
              "tex": "E_{C} = \\dfrac{100 \\cdot (4\\sqrt{10})^{2}}{2} + 100 \\cdot 10 \\cdot 8"
            },
            {
              "t": "eq",
              "tex": "E_{C} = 50 \\cdot 160 + 8\\,000 = 16\\,000\\ \\text{J}"
            }
          ]
        },
        {
          "titulo": "A energia em B",
          "blocos": [
            {
              "t": "texto",
              "html": "Em B, no nível de referência, a energia mecânica é só cinética. De B a C, a água tirou 20% dela: sobraram <b>80%</b>."
            },
            {
              "t": "eq",
              "tex": "0,8\\, E_{cB} = 16\\,000"
            },
            {
              "t": "eq",
              "tex": "E_{cB} = \\dfrac{16\\,000}{0,8} = 20\\,000\\ \\text{J}"
            }
          ]
        },
        {
          "titulo": "A velocidade e a quantidade de movimento",
          "blocos": [
            {
              "t": "eq",
              "tex": "\\dfrac{m\\, v_{B}^{2}}{2} = 20\\,000"
            },
            {
              "t": "eq",
              "tex": "50\\, v_{B}^{2} = 20\\,000 \\quad \\Rightarrow \\quad v_{B}^{2} = 400 \\quad \\Rightarrow \\quad v_{B} = 20\\ \\text{m/s}"
            },
            {
              "t": "texto",
              "html": "Quantidade de movimento:"
            },
            {
              "t": "eq",
              "tex": "Q = m\\, v_{B} = 100 \\cdot 20 = 2\\,000\\ \\text{kg} \\cdot \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
