{
  "id": "unesp-2025-q76",
  "formato": "aula",
  "titulo": "Da manivela ao cesto",
  "conceitos": [
    "Transmissão de movimento circular",
    "Frequência"
  ],
  "cena": {
    "modelo": "engrenagens-internas",
    "parametros": {
      "razao": 3
    }
  },
  "metodos": [
    {
      "nome": "Engrenagens acopladas",
      "telas": [
        {
          "titulo": "O mecanismo",
          "cena": {
            "mostrar": [
              "engrenagem-a",
              "engrenagem-b",
              "manivela"
            ],
            "estado": {
              "girar": true
            }
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A manivela M gira presa à engrenagem A:"
            },
            {
              "t": "eq",
              "tex": "f_{A} = 2,4\\ \\text{Hz}"
            },
            {
              "t": "texto",
              "html": "A e B estão <b>engrenadas</b>: os pontos em contato têm a <b>mesma velocidade linear</b>."
            }
          ]
        },
        {
          "titulo": "Mesma velocidade no contato",
          "cena": {
            "mostrar": [
              "engrenagem-a",
              "engrenagem-b",
              "manivela",
              "contato",
              "raios"
            ],
            "estado": {
              "girar": true
            },
            "destacar": [
              "contato"
            ]
          },
          "blocos": [
            {
              "t": "eq",
              "tex": "v_{A} = v_{B}"
            },
            {
              "t": "eq",
              "tex": "\\marca{p}{2\\pi} f_{A} R_{A} = \\marca{q}{2\\pi} f_{B} R_{B}"
            },
            {
              "t": "eq",
              "tex": "f_{A} R_{A} = f_{B} R_{B}",
              "cancelar": [
                "p",
                "q"
              ]
            },
            {
              "t": "texto",
              "html": "O raio de A é o <b>triplo</b> do raio de B: R<sub>A</sub> = 3R<sub>B</sub>."
            },
            {
              "t": "eq",
              "tex": "f_{A} \\cdot 3\\marca{r}{R_{B}} = f_{B}\\, \\marca{s}{R_{B}}"
            },
            {
              "t": "eq",
              "tex": "f_{B} = 3 f_{A} = 3 \\cdot 2,4",
              "cancelar": [
                "r",
                "s"
              ]
            },
            {
              "t": "eq",
              "tex": "f_{B} = 7,2\\ \\text{Hz}"
            }
          ]
        },
        {
          "titulo": "O cesto",
          "cena": {
            "mostrar": [
              "engrenagem-a",
              "engrenagem-b",
              "manivela",
              "contato",
              "raios",
              "roda"
            ],
            "estado": {
              "girar": true
            },
            "destacar": [
              "roda"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A engrenagem B e a roda R estão presas ao <b>mesmo eixo</b>: giram com a <b>mesma frequência</b>, e o cesto, fixo em R, também."
            },
            {
              "t": "eq",
              "tex": "f_{\\text{cesto}} = f_{B} = 7,2\\ \\text{Hz}"
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
