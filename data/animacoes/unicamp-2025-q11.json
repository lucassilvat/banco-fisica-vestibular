  "metodos": [
    {
      "nome": "Equação fundamental",
      "telas": [
        {
          "titulo": "A velocidade",
          "blocos": [
            {
              "t": "texto",
              "html": "Os dois feixes se propagam <b>no mesmo meio</b>: têm a mesma velocidade. Isso descarta (c) e (d)."
            },
            {
              "t": "eq",
              "tex": "v_{2} = v_{1}"
            }
          ]
        },
        {
          "titulo": "A frequência",
          "blocos": [
            {
              "t": "texto",
              "html": "Equação fundamental da ondulatória:"
            },
            {
              "t": "eq",
              "tex": "v = \\lambda\\, \\marca{f}{f}"
            },
            {
              "t": "eq",
              "tex": "\\marca{f}{f} = \\dfrac{v}{\\lambda}",
              "mover": [
                "f"
              ]
            },
            {
              "t": "texto",
              "html": "Com a mesma velocidade, f é inversamente proporcional a λ. Como λ<sub>2</sub> = 350 nm é maior que λ<sub>1</sub> = 128 nm:"
            },
            {
              "t": "eq",
              "tex": "f_{2} < f_{1}"
            },
            {
              "t": "gabarito",
              "letra": "b"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
