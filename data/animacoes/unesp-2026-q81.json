  "abertura": [
    {
      "titulo": "Resolução",
      "blocos": [
        {
          "t": "texto",
          "html": "Há <b>dois caminhos</b> para resolver esta questão:"
        },
        {
          "t": "texto",
          "html": "1) Usar o <b>campo elétrico</b>: num campo uniforme, E = U/d, e a força é F = qE."
        },
        {
          "t": "texto",
          "html": "2) Usar o <b>trabalho</b> da força elétrica, que pode ser escrito de duas formas."
        },
        {
          "t": "texto",
          "html": "Escolha um método nas abas acima, ou avance para ver os dois."
        }
      ]
    }
  ],
  "metodos": [
    {
      "nome": "Pelo campo elétrico",
      "telas": [
        {
          "titulo": "As duas relações",
          "cena": {
            "mostrar": [
              "placas",
              "ion"
            ],
            "animar": [
              "migra"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Entre os eletrodos, o campo elétrico é <b>uniforme</b>. Nesse caso:"
            },
            {
              "t": "eq",
              "tex": "U = E \\cdot d \\quad \\Rightarrow \\quad E = \\dfrac{U}{d}"
            },
            {
              "t": "texto",
              "html": "A força sobre uma carga q num campo E é:"
            },
            {
              "t": "eq",
              "tex": "F = q E"
            }
          ]
        },
        {
          "titulo": "A força",
          "cena": {
            "mostrar": [
              "placas",
              "ion"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Juntando as duas:"
            },
            {
              "t": "eq",
              "tex": "F = \\dfrac{q U}{d}"
            },
            {
              "t": "eq",
              "tex": "F = \\dfrac{1,6 \\times 10^{-19} \\cdot 4}{5 \\times 10^{-3}}"
            },
            {
              "t": "texto",
              "html": "1,6 · 4 = 6,4, e 6,4 ÷ 5 = 1,28:"
            },
            {
              "t": "eq",
              "tex": "F = 1,28 \\times 10^{-16}\\ \\text{N}"
            },
            {
              "t": "gabarito",
              "letra": "C"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    },
    {
      "nome": "Pelo trabalho",
      "telas": [
        {
          "titulo": "Duas formas do mesmo trabalho",
          "cena": {
            "mostrar": [
              "placas",
              "ion"
            ],
            "animar": [
              "migra"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Ao atravessar de um eletrodo ao outro, o íon recebe da força elétrica um <b>trabalho</b>."
            },
            {
              "t": "texto",
              "html": "Pela ddp entre os eletrodos:"
            },
            {
              "t": "eq",
              "tex": "\\tau = q U"
            },
            {
              "t": "texto",
              "html": "Como a força é <b>constante</b> e tem a direção do deslocamento:"
            },
            {
              "t": "eq",
              "tex": "\\tau = F d"
            }
          ]
        },
        {
          "titulo": "A força",
          "cena": {
            "mostrar": [
              "placas",
              "ion"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Igualando:"
            },
            {
              "t": "eq",
              "tex": "F \\marca{d}{d} = q U"
            },
            {
              "t": "texto",
              "html": "A distância <b>passa para o outro lado</b>, dividindo:"
            },
            {
              "t": "eq",
              "tex": "F = \\dfrac{q U}{\\marca{d}{d}}",
              "mover": [
                "d"
              ]
            },
            {
              "t": "eq",
              "tex": "F = \\dfrac{1,6 \\times 10^{-19} \\cdot 4}{5 \\times 10^{-3}}"
            },
            {
              "t": "eq",
              "tex": "F = 1,28 \\times 10^{-16}\\ \\text{N}"
            },
            {
              "t": "gabarito",
              "letra": "C"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
