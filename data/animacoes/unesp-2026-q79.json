  "metodos": [
    {
      "nome": "Equação de Gauss",
      "telas": [
        {
          "titulo": "A ferramenta",
          "cena": {
            "mostrar": [
              "muro",
              "carro"
            ],
            "animar": [
              "aproxima"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Para o espelho, a <b>equação de Gauss</b> relaciona objeto (p), imagem (p') e foco (f):"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{1}{f} = \\dfrac{1}{p} + \\marca{q}{\\dfrac{1}{p'}}"
            },
            {
              "t": "texto",
              "html": "Isolamos 1/p: o termo da imagem <b>passa para o outro lado</b>, subtraindo."
            },
            {
              "t": "eq",
              "tex": "\\dfrac{1}{f} - \\marca{q}{\\dfrac{1}{p'}} = \\dfrac{1}{p}",
              "mover": [
                "q"
              ]
            },
            {
              "t": "texto",
              "html": "O espelho é <b>convexo</b>: a imagem é virtual, então p' é <b>negativo</b>. E o foco também:"
            },
            {
              "t": "eq",
              "tex": "f = -0,8 = -\\dfrac{8}{10} \\quad \\Rightarrow \\quad \\dfrac{1}{f} = -\\dfrac{10}{8}"
            }
          ]
        },
        {
          "titulo": "Distância no instante inicial",
          "cena": {
            "mostrar": [
              "muro",
              "espelho0"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Em <b>t = 0</b>, a imagem está a 8/11 m: p' = −8/11 m."
            },
            {
              "t": "eq",
              "tex": "\\dfrac{1}{d_{0}} = -\\dfrac{10}{8} + \\dfrac{11}{8}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{1}{d_{0}} = \\dfrac{1}{8}"
            },
            {
              "t": "eq",
              "tex": "d_{0} = 8\\ \\text{m}"
            }
          ]
        },
        {
          "titulo": "Distância dois segundos depois",
          "cena": {
            "mostrar": [
              "muro",
              "espelho0",
              "espelho1"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Em <b>t = 2 s</b>, a imagem está a 20/29 m: p' = −20/29 m."
            },
            {
              "t": "eq",
              "tex": "\\dfrac{1}{d_{1}} = -\\dfrac{10}{8} + \\dfrac{29}{20}"
            },
            {
              "t": "texto",
              "html": "Com denominador comum 40:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{1}{d_{1}} = -\\dfrac{50}{40} + \\dfrac{58}{40} = \\dfrac{8}{40} = \\dfrac{1}{5}"
            },
            {
              "t": "eq",
              "tex": "d_{1} = 5\\ \\text{m}"
            }
          ]
        },
        {
          "titulo": "A velocidade",
          "cena": {
            "mostrar": [
              "muro",
              "espelho0",
              "espelho1"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O carro se aproxima com velocidade <b>constante</b>: em 2 s, andou de 8 m para 5 m do muro."
            },
            {
              "t": "eq",
              "tex": "v = \\dfrac{8 - 5}{2}"
            },
            {
              "t": "eq",
              "tex": "v = 1,5\\ \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "C"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
