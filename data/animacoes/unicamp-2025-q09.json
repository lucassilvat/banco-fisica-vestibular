  "metodos": [
    {
      "nome": "Movimento circular uniforme",
      "telas": [
        {
          "titulo": "Uma volta completa",
          "blocos": [
            {
              "t": "texto",
              "html": "Em uma volta, a sonda percorre o comprimento da circunferência, 2πr, durante um período T:"
            },
            {
              "t": "eq",
              "tex": "v = \\dfrac{\\Delta s}{\\Delta t} = \\dfrac{2\\pi\\, r}{T}"
            },
            {
              "t": "texto",
              "html": "O período no SI:"
            },
            {
              "t": "eq",
              "tex": "T = 2,0\\ \\text{h} = 2 \\cdot 3\\,600 = 7\\,200\\ \\text{s}"
            }
          ]
        },
        {
          "titulo": "A velocidade",
          "blocos": [
            {
              "t": "texto",
              "html": "Com π ≈ 3,0:"
            },
            {
              "t": "eq",
              "tex": "v = \\dfrac{2 \\cdot 3,0 \\cdot 1,848 \\cdot 10^{6}}{7\\,200} = \\dfrac{\\marca{a}{6} \\cdot 1,848 \\cdot 10^{6}}{\\marca{b}{6} \\cdot 1\\,200}"
            },
            {
              "t": "eq",
              "tex": "v = \\dfrac{1\\,848\\,000}{1\\,200}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "eq",
              "tex": "v = 1\\,540\\ \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "b"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
