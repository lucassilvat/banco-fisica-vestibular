{
  "id": "unesp-2018-q81",
  "formato": "aula",
  "titulo": "Do nível sonoro à energia no tímpano",
  "conceitos": [
    "Nível sonoro",
    "Intensidade de onda"
  ],
  "metodos": [
    {
      "nome": "Nível sonoro e energia",
      "telas": [
        {
          "titulo": "O nível sonoro",
          "blocos": [
            {
              "t": "texto",
              "html": "A definição de nível sonoro, com β = 60 dB:"
            },
            {
              "t": "eq",
              "tex": "\\beta = 10 \\log\\dfrac{I}{I_{0}}"
            },
            {
              "t": "eq",
              "tex": "60 = \\marca{d}{10} \\log\\dfrac{I}{10^{-12}}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{60}{\\marca{d}{10}} = \\log\\dfrac{I}{10^{-12}}",
              "mover": [
                "d"
              ]
            },
            {
              "t": "eq",
              "tex": "\\log\\dfrac{I}{10^{-12}} = 6"
            }
          ]
        },
        {
          "titulo": "A intensidade",
          "blocos": [
            {
              "t": "texto",
              "html": "Pela definição de logaritmo (base 10), o 6 é o expoente de 10:"
            },
            {
              "t": "eq",
              "tex": "\\log_{\\marca{b}{10}} \\dfrac{I}{10^{-12}} = \\marca{e}{6}"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{I}{10^{-12}} = \\marca{b}{10}^{\\marca{e}{6}}",
              "mover": [
                "b",
                "e"
              ]
            },
            {
              "t": "eq",
              "tex": "I = 10^{6} \\cdot 10^{-12} = 10^{-6}\\ \\text{W/m}^{2}"
            }
          ]
        },
        {
          "titulo": "A potência no tímpano",
          "blocos": [
            {
              "t": "texto",
              "html": "Intensidade é potência por unidade de área:"
            },
            {
              "t": "eq",
              "tex": "I = \\dfrac{P}{\\marca{a}{A}}"
            },
            {
              "t": "eq",
              "tex": "P = I \\cdot \\marca{a}{A}",
              "mover": [
                "a"
              ]
            },
            {
              "t": "eq",
              "tex": "P = 10^{-6} \\cdot 6,0 \\cdot 10^{-5} = 6,0 \\cdot 10^{-11}\\ \\text{W}"
            }
          ]
        },
        {
          "titulo": "A energia em 5,0 s",
          "blocos": [
            {
              "t": "texto",
              "html": "Potência é energia por unidade de tempo:"
            },
            {
              "t": "eq",
              "tex": "P = \\dfrac{E}{\\marca{t}{\\Delta t}}"
            },
            {
              "t": "eq",
              "tex": "E = P \\cdot \\marca{t}{\\Delta t}",
              "mover": [
                "t"
              ]
            },
            {
              "t": "eq",
              "tex": "E = 6,0 \\cdot 10^{-11} \\cdot 5,0 = 30 \\cdot 10^{-11}"
            },
            {
              "t": "eq",
              "tex": "E = 3,0 \\cdot 10^{-10}\\ \\text{J}"
            },
            {
              "t": "gabarito",
              "letra": "C"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
