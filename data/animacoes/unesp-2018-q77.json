{
  "id": "unesp-2018-q77",
  "formato": "aula",
  "titulo": "A energia de cada mola e sua constante elástica",
  "conceitos": [
    "Energia potencial elástica"
  ],
  "metodos": [
    {
      "nome": "Energia potencial elástica",
      "telas": [
        {
          "titulo": "A energia de cada mola",
          "blocos": [
            {
              "t": "texto",
              "html": "45% dos 160 J vão para as molas:"
            },
            {
              "t": "eq",
              "tex": "0,45 \\cdot 160 = 72\\ \\text{J}"
            },
            {
              "t": "texto",
              "html": "Divididos igualmente entre as 32 molas:"
            },
            {
              "t": "eq",
              "tex": "E = \\dfrac{72}{32} = 2,25\\ \\text{J por mola}"
            }
          ]
        },
        {
          "titulo": "A fórmula",
          "blocos": [
            {
              "t": "texto",
              "html": "A energia potencial elástica de uma mola distendida de x:"
            },
            {
              "t": "eq",
              "tex": "E = \\dfrac{k\\, x^{2}}{2}"
            },
            {
              "t": "texto",
              "html": "Isolamos k: o 2 e o x² passam para o outro lado."
            },
            {
              "t": "eq",
              "tex": "\\dfrac{k\\, \\marca{x}{x^{2}}}{\\marca{d}{2}} = E"
            },
            {
              "t": "eq",
              "tex": "k = \\dfrac{\\marca{d}{2}\\, E}{\\marca{x}{x^{2}}}",
              "mover": [
                "d",
                "x"
              ]
            }
          ]
        },
        {
          "titulo": "A constante elástica",
          "blocos": [
            {
              "t": "texto",
              "html": "Com x = 3,0 mm = 3,0 · 10<sup>−3</sup> m:"
            },
            {
              "t": "eq",
              "tex": "k = \\dfrac{2 \\cdot 2,25}{(3,0 \\cdot 10^{-3})^{2}} = \\dfrac{4,5}{9,0 \\cdot 10^{-6}}"
            },
            {
              "t": "eq",
              "tex": "k = 0,5 \\cdot 10^{6} = 5,0 \\cdot 10^{5}\\ \\text{N/m}"
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
