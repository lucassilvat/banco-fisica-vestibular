  "metodos": [
    {
      "nome": "Conservação da energia",
      "telas": [
        {
          "titulo": "A energia se conserva",
          "cena": {
            "mostrar": [
              "pista",
              "alturas",
              "bola"
            ],
            "animar": [
              "descer"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Sem atrito e sem resistência do ar, a <b>energia mecânica se conserva</b> do ponto 1 (repouso, a 1,8 m do solo) até o ponto 3 (a 1,6 m)."
            },
            {
              "t": "texto",
              "html": "No ponto 3, o mais alto da parábola, a velocidade é só <b>horizontal</b>: v = v<sub>x</sub>."
            }
          ]
        },
        {
          "titulo": "A componente horizontal no ponto 3",
          "cena": {
            "mostrar": [
              "pista",
              "alturas",
              "bola",
              "velocidade-3"
            ],
            "destacar": [
              "velocidade-3"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A massa aparece em todos os termos e <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "\\marca{a}{m}\\, g \\cdot 1,8 = \\marca{b}{m}\\, g \\cdot 1,6 + \\dfrac{\\marca{c}{m}\\, v_{x}^{2}}{2}"
            },
            {
              "t": "eq",
              "tex": "10 \\cdot 1,8 = \\marca{s}{10 \\cdot 1,6} + \\dfrac{v_{x}^{2}}{2}",
              "cancelar": [
                "a",
                "b",
                "c"
              ]
            },
            {
              "t": "eq",
              "tex": "10 \\cdot 1,8 - \\marca{s}{10 \\cdot 1,6} = \\dfrac{v_{x}^{2}}{2}",
              "mover": [
                "s"
              ]
            },
            {
              "t": "eq",
              "tex": "2 = \\dfrac{v_{x}^{2}}{2} \\quad \\Rightarrow \\quad v_{x}^{2} = 4"
            },
            {
              "t": "eq",
              "tex": "v_{x} = 2,0\\ \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "C"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
