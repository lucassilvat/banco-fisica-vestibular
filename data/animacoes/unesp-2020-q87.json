{
  "id": "unesp-2020-q87",
  "formato": "aula",
  "titulo": "Quanto pesaria a taça maciça de ouro 18 quilates",
  "conceitos": [
    "Densidade",
    "Volume do cilindro"
  ],
  "metodos": [
    {
      "nome": "Volume e densidade média",
      "telas": [
        {
          "titulo": "O volume",
          "blocos": [
            {
              "t": "texto",
              "html": "Volume do cilindro, com π = 3:"
            },
            {
              "t": "eq",
              "tex": "V = \\pi r^{2} h = 3 \\cdot 5^{2} \\cdot 36"
            },
            {
              "t": "eq",
              "tex": "V = 2\\,700\\ \\text{cm}^{3}"
            }
          ]
        },
        {
          "titulo": "A densidade do ouro 18 quilates",
          "blocos": [
            {
              "t": "texto",
              "html": "Em cada grama de ouro 18 quilates há 0,75 g de ouro e 0,25 g de liga. O volume desse grama:"
            },
            {
              "t": "eq",
              "tex": "\\dfrac{0,75}{19,3} + \\dfrac{0,25}{6,1} \\approx 0,0389 + 0,0410 = 0,0799\\ \\text{cm}^{3}"
            },
            {
              "t": "texto",
              "html": "Densidade média:"
            },
            {
              "t": "eq",
              "tex": "d \\approx \\dfrac{1}{0,0799} \\approx 12,5\\ \\text{g/cm}^{3}"
            }
          ]
        },
        {
          "titulo": "A massa",
          "blocos": [
            {
              "t": "eq",
              "tex": "m = d\\, V \\approx 12,5 \\cdot 2\\,700"
            },
            {
              "t": "eq",
              "tex": "m \\approx 33\\,800\\ \\text{g} \\approx 33,8\\ \\text{kg}"
            },
            {
              "t": "texto",
              "html": "Entre <b>30 kg e 35 kg</b>."
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
