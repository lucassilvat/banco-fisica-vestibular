            "borda": "tinta"
          },
          {
            "t": "texto",
            "x": 320,
            "y": 395,
            "txt": "Terra: massa M, raio R",
            "negrito": true
          },
          {
            "t": "cota",
            "de": [
              320,
              235
            ],
            "para": [
              432.6,
              300.0
            ],
            "cor": "#111111",
            "txt": "R"
          }
        ],
        "corpo": [
          {
            "t": "circ",
            "x": 320,
            "y": 93,
            "r": 12,
            "cor": "#2e9e5b",
            "borda": "#111111",
            "larg": 2
          },
          {
            "t": "texto",
            "x": 342,
            "y": 91,
            "txt": "corpo de massa m",
            "negrito": true,
            "ancora": "start"
          }
        ],
        "forca": [
          {
            "t": "seta",
            "de": [
              320,
              93
            ],
            "para": [
              320,
