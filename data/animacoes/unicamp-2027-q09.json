    }
  },
  "metodos": [
    {
      "nome": "Gravitação e peso",
      "telas": [
        {
          "titulo": "A força gravitacional",
          "cena": {
            "mostrar": [
              "terra",
              "corpo",
              "forca"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A Terra atrai o corpo de massa m com a força gravitacional \\(\\vec{F}\\), dirigida para o centro da Terra. Pela lei da gravitação universal, a uma distância R do centro:"
            },
            {
              "t": "eq",
              "tex": "F = \\dfrac{G\\, M\\, m}{R^{2}}"
            }
          ]
        },
        {
          "titulo": "A aceleração da gravidade",
          "cena": {
            "mostrar": [
              "terra",
              "corpo",
              "forca"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Na superfície, essa força é o <b>peso</b> do corpo:"
            },
            {
              "t": "eq",
              "tex": "P = m\\, g"
            },
            {
              "t": "texto",
              "html": "Igualamos as duas:"
            },
            {
              "t": "eq",
              "tex": "\\marca{a}{m}\\, g = \\dfrac{G\\, M\\, \\marca{b}{m}}{R^{2}}"
            },
            {
              "t": "eq",
              "tex": "g = \\dfrac{G\\, M}{R^{2}}",
              "cancelar": [
                "a",
                "b"
              ]
            }
          ]
        },
        {
          "titulo": "As proporções",
          "cena": {
            "mostrar": [
              "terra",
              "corpo",
              "forca"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A massa m do corpo se cancelou: g é <b>independente de m</b>."
            },
            {
              "t": "texto",
              "html": "M está no numerador: g é <b>diretamente proporcional</b> a M. R² está no denominador: g é <b>inversamente proporcional</b> ao quadrado do raio."
            },
            {
              "t": "texto",
              "html": "Atenção: a <b>força</b> é proporcional a m (alternativa c), mas a pergunta, sublinhada, é sobre a <b>aceleração</b>."
            },
            {
              "t": "gabarito",
              "letra": "b"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
