  "titulo": "A energia da bateria erguendo uma massa",
  "conceitos": [
    "Energia potencial gravitacional"
  ],
  "metodos": [
    {
      "nome": "Energia potencial",
      "telas": [
        {
          "titulo": "Wh em joules",
          "blocos": [
            {
              "t": "texto",
              "html": "1 Wh é a energia de 1 W durante 1 h = 3 600 s:"
            },
            {
              "t": "eq",
              "tex": "1\\ \\text{Wh} = 1\\ \\text{W} \\cdot 3\\,600\\ \\text{s} = 3\\,600\\ \\text{J}"
            },
            {
              "t": "eq",
              "tex": "E_{b} = 15 \\cdot 3\\,600 = 54\\,000\\ \\text{J}"
            }
          ]
        },
        {
          "titulo": "A altura",
          "blocos": [
            {
              "t": "texto",
              "html": "A energia potencial gravitacional a uma altura y:"
            },
            {
              "t": "eq",
              "tex": "E_{p} = m\\, g\\, y"
            },
            {
              "t": "texto",
              "html": "Ela deve ser igual a E<sub>b</sub>:"
            },
            {
              "t": "eq",
              "tex": "\\marca{m}{m\\, g}\\, y = E_{b}"
            },
            {
              "t": "eq",
              "tex": "y = \\dfrac{E_{b}}{\\marca{m}{m\\, g}}",
              "mover": [
                "m"
              ]
            },
            {
              "t": "eq",
              "tex": "y = \\dfrac{54\\,000}{45 \\cdot 10} = \\dfrac{54\\,000}{450} = 120\\ \\text{m}"
            },
            {
              "t": "gabarito",
              "letra": "c"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
