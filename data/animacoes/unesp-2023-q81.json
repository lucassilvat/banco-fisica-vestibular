        "mostrar": [
          "corda-1"
        ]
      }
    },
    {
      "titulo": "Frequência e comprimento",
      "conceito": "Ondas estacionárias e cordas vibrantes",
      "texto": "No modo fundamental, o comprimento da corda é meio comprimento de onda. Com v igual, a frequência é inversamente proporcional ao comprimento.",
      "equacoes": [
        "\\mathrm{L} = \\dfrac{\\lambda}{2} \\quad \\Rightarrow \\quad \\mathrm{f} = \\dfrac{v}{2\\mathrm{L}}"
      ],
      "cena": {
        "mostrar": [
          "modo"
        ]
      }
    },
    {
      "titulo": "O comprimento da corda 2",
      "conceito": "Ondas estacionárias e cordas vibrantes",
      "texto": "A frequência da corda 1 é 150 vezes a da corda 2, então a corda 2 é 150 vezes mais longa. Resposta: <b>(A) 7,5 m</b>.",
      "equacoes": [
        "\\dfrac{\\mathrm{f}_1}{\\mathrm{f}_2} = \\dfrac{\\mathrm{L}_2}{\\mathrm{L}_1} = 150 \\quad \\Rightarrow \\quad \\mathrm{L}_2 = 150 \\cdot 5\\ \\text{cm} = 7,5\\ \\text{m}"
      ],
