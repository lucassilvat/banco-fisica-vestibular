          "blocos": [
            {
              "t": "texto",
              "html": "A sombra oscila entre A e B enquanto a esfera balança."
            },
            {
              "t": "texto",
              "html": "Para a <b>aceleração escalar média</b>, só precisamos da velocidade em dois instantes:"
            },
            {
              "t": "eq",
              "tex": "a_{m} = \\dfrac{\\Delta v}{\\Delta t} = \\dfrac{v(4) - v(1)}{4 - 1}"
            }
          ]
        },
        {
          "titulo": "As duas velocidades",
          "blocos": [
            {
              "t": "texto",
              "html": "Em <b>t = 1 s</b>, o argumento do seno vale π/2, e sen(π/2) = 1:"
            },
            {
              "t": "eq",
              "tex": "v(1) = -\\dfrac{0,3\\pi}{2} \\cdot \\sen\\dfrac{\\pi}{2}"
            },
            {
              "t": "eq",
              "tex": "v(1) = -0,15\\pi\\ \\text{m/s}"
            },
            {
              "t": "texto",
              "html": "Em <b>t = 4 s</b>, o argumento vale 2π, e sen(2π) = 0:"
            },
            {
              "t": "eq",
              "tex": "v(4) = -\\dfrac{0,3\\pi}{2} \\cdot \\sen 2\\pi = 0"
            }
          ]
        },
        {
          "titulo": "A aceleração média",
          "blocos": [
            {
              "t": "texto",
              "html": "Substituindo na definição:"
            },
            {
              "t": "eq",
              "tex": "a_{m} = \\dfrac{0 - (-0,15\\pi)}{3}"
            },
            {
              "t": "eq",
              "tex": "a_{m} = \\dfrac{0,15\\pi}{3}"
            },
            {
              "t": "eq",
              "tex": "a_{m} = 0,05\\pi\\ \\text{m/s}^{2}"
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
