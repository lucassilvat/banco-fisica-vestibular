          "titulo": "A fórmula",
          "blocos": [
            {
              "t": "texto",
              "html": "A potência elétrica de um aparelho é o produto da tensão pela corrente:"
            },
            {
              "t": "eq",
              "tex": "P = \\marca{u}{U}\\, i"
            },
            {
              "t": "eq",
              "tex": "i = \\dfrac{P}{\\marca{u}{U}}",
              "mover": [
                "u"
              ]
            }
          ]
        },
        {
          "titulo": "A corrente",
          "blocos": [
            {
              "t": "texto",
              "html": "Com P = 3,0 W e U = 12 V:"
            },
            {
              "t": "eq",
              "tex": "i = \\dfrac{3,0}{12} = \\dfrac{\\marca{a}{3}}{4 \\cdot \\marca{b}{3}}"
            },
            {
              "t": "eq",
              "tex": "i = \\dfrac{1}{4} = 0,25\\ \\text{A}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "gabarito",
              "letra": "b"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
