  ],
  "metodos": [
    {
      "nome": "Da frequência à cor",
      "telas": [
        {
          "titulo": "O comprimento de onda",
          "blocos": [
            {
              "t": "texto",
              "html": "Equação fundamental da ondulatória, com c = 300 000 km/s = 3 · 10<sup>8</sup> m/s:"
            },
            {
              "t": "eq",
              "tex": "c = \\lambda\\, \\marca{f}{f}"
            },
            {
              "t": "eq",
              "tex": "\\lambda = \\dfrac{c}{\\marca{f}{f}}",
              "mover": [
                "f"
              ]
            },
            {
              "t": "eq",
              "tex": "\\lambda = \\dfrac{3 \\cdot 10^{8}}{4,8 \\cdot 10^{14}} = 0,625 \\cdot 10^{-6}"
            },
            {
              "t": "eq",
              "tex": "\\lambda = 6,25 \\cdot 10^{-7}\\ \\text{m}"
            }
          ]
        },
        {
          "titulo": "A cor da luz",
          "blocos": [
            {
              "t": "texto",
              "html": "No espectro dado, 6,25 · 10<sup>−7</sup> m fica entre 6 · 10<sup>−7</sup> m e 7 · 10<sup>−7</sup> m, do lado do <b>vermelho</b>, longe do verde."
            },
            {
              "t": "texto",
              "html": "Pelo esquema do texto, a luz vermelha é emitida pela <b>oxiluciferina na forma ceto</b>."
            }
          ]
        },
        {
          "titulo": "A molécula",
          "blocos": [
            {
              "t": "texto",
              "html": "A parte de Química: na estrutura da forma aniônica da oxiluciferina ceto contam-se 10 C, 5 H, 2 O, 2 N e 2 S, e entre as funções listadas a presente é a amina:"
            },
            {
              "t": "eq",
              "tex": "\\text{C}_{10}\\text{H}_{5}\\text{O}_{2}\\text{N}_{2}\\text{S}_{2}"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
