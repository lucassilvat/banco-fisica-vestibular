{
  "id": "unesp-2025-q90",
  "formato": "aula",
  "titulo": "Tempos em progressão geométrica",
  "conceitos": [
    "Velocidade escalar média",
    "Progressão geométrica"
  ],
  "cena": {
    "modelo": "triangulo-pg",
    "parametros": {}
  },
  "metodos": [
    {
      "nome": "Soma da PG",
      "telas": [
        {
          "titulo": "O primeiro lado",
          "cena": {
            "mostrar": [
              "triangulo",
              "particula"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Primeiro, as unidades: lado e velocidade em metros e segundos."
            },
            {
              "t": "eq",
              "tex": "10\\ \\text{cm} = 0,1\\ \\text{m}"
            },
            {
              "t": "eq",
              "tex": "6\\ \\text{m/min} = \\dfrac{6\\ \\text{m}}{60\\ \\text{s}} = 0,1\\ \\text{m/s}"
            },
            {
              "t": "texto",
              "html": "O primeiro lado leva:"
            },
            {
              "t": "eq",
              "tex": "t_{1} = \\dfrac{0,1}{0,1} = 1\\ \\text{s}"
            }
          ]
        },
        {
          "titulo": "A velocidade dobra, o tempo cai pela metade",
          "cena": {
            "mostrar": [
              "triangulo",
              "particula",
              "tempos"
            ],
            "estado": {
              "percorrer": true
            }
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Mesmo comprimento, velocidade <b>dobrada</b>: cada lado leva a <b>metade</b> do tempo do anterior."
            },
            {
              "t": "eq",
              "tex": "1 + \\dfrac{1}{2} + \\dfrac{1}{4} + \\dfrac{1}{8} + \\cdots"
            },
            {
              "t": "texto",
              "html": "10 voltas são 30 lados: somamos 30 termos de uma PG de razão 1/2."
            }
          ]
        },
        {
          "titulo": "Somando os tempos",
          "cena": {
            "mostrar": [
              "triangulo",
              "particula",
              "tempos",
              "soma"
            ],
            "estado": {
              "percorrer": true
            },
            "destacar": [
              "soma"
            ]
          },
          "blocos": [
            {
              "t": "eq",
              "tex": "S_{30} = \\dfrac{1 \\cdot \\left(1 - \\left(\\tfrac{1}{2}\\right)^{30}\\right)}{1 - \\tfrac{1}{2}}"
            },
            {
              "t": "eq",
              "tex": "S_{30} = 2\\left(1 - \\left(\\tfrac{1}{2}\\right)^{30}\\right)"
            },
            {
              "t": "texto",
              "html": "(1/2)<sup>30</sup> é menor que um bilionésimo: desprezível."
            },
            {
              "t": "eq",
              "tex": "S_{30} \\approx 2\\ \\text{s}"
            },
            {
              "t": "gabarito",
              "letra": "A"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
