{
  "id": "unicamp-2027-q08",
  "formato": "aula",
  "titulo": "Quão longe estava a fusão dos buracos negros",
  "conceitos": [
    "Movimento uniforme",
    "Notação científica"
  ],
  "abertura": [
    {
      "titulo": "Resolução",
      "blocos": [
        {
          "t": "texto",
          "html": "Há dois caminhos:"
        },
        {
          "t": "texto",
          "html": "1) Fazer as contas completas com d = c · Δt."
        },
        {
          "t": "texto",
          "html": "2) Usar valores <b>aproximados</b>, como na hora da prova."
        },
        {
          "t": "texto",
          "html": "Escolha um método nas abas acima, ou avance para ver os dois."
        }
      ]
    }
  ],
  "metodos": [
    {
      "nome": "Movimento uniforme",
      "telas": [
        {
          "titulo": "A fórmula",
          "blocos": [
            {
              "t": "texto",
              "html": "A onda viaja com velocidade constante, praticamente igual a c: movimento uniforme."
            },
            {
              "t": "eq",
              "tex": "v = \\dfrac{\\Delta s}{\\marca{t}{\\Delta t}}"
            },
            {
              "t": "eq",
              "tex": "\\Delta s = v \\cdot \\marca{t}{\\Delta t}",
              "mover": [
                "t"
              ]
            },
            {
              "t": "texto",
              "html": "Aqui, Δs = d e v = c:"
            },
            {
              "t": "eq",
              "tex": "d = c \\cdot \\Delta t"
            }
          ]
        },
        {
          "titulo": "O tempo em segundos",
          "blocos": [
            {
              "t": "texto",
              "html": "O tempo de viagem em segundos: 1,3 bilhão de anos = 1,3 · 10<sup>9</sup> anos, com 3,2 · 10<sup>7</sup> s em cada ano."
            },
            {
              "t": "eq",
              "tex": "\\Delta t = 1,3 \\cdot 10^{9} \\cdot 3,2 \\cdot 10^{7}"
            },
            {
              "t": "eq",
              "tex": "\\Delta t = 4,16 \\cdot 10^{16}\\ \\text{s}"
            }
          ]
        },
        {
          "titulo": "A distância",
          "blocos": [
            {
              "t": "eq",
              "tex": "d = 3,0 \\cdot 10^{8} \\cdot 4,16 \\cdot 10^{16}"
            },
            {
              "t": "eq",
              "tex": "d = 12,48 \\cdot 10^{24}\\ \\text{m}"
            },
            {
              "t": "eq",
              "tex": "d \\approx 1,2 \\cdot 10^{25}\\ \\text{m}"
            },
            {
              "t": "gabarito",
              "letra": "a"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    },
    {
      "nome": "Aproximando",
      "telas": [
        {
          "titulo": "Arredondando",
          "blocos": [
            {
              "t": "texto",
              "html": "Na hora da prova, dá para arredondar: as alternativas diferem por potências de 10."
            },
            {
              "t": "eq",
              "tex": "1,3 \\cdot 3,2 \\approx 4 \\quad \\Rightarrow \\quad \\Delta t \\approx 4 \\cdot 10^{16}\\ \\text{s}"
            },
            {
              "t": "eq",
              "tex": "d \\approx 3 \\cdot 10^{8} \\cdot 4 \\cdot 10^{16}"
            },
            {
              "t": "eq",
              "tex": "d \\approx 12 \\cdot 10^{24} = 1,2 \\cdot 10^{25}\\ \\text{m}"
            },
            {
              "t": "texto",
              "html": "O mesmo resultado: a alternativa não muda."
            },
            {
              "t": "gabarito",
              "letra": "a"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
