          ]
        },
        {
          "titulo": "Quanto metano queimar",
          "blocos": [
            {
              "t": "texto",
              "html": "Cada mol de metano queimado libera 9 · 10<sup>2</sup> kJ:"
            },
            {
              "t": "eq",
              "tex": "n = \\dfrac{5,4 \\cdot 10^{8}}{9 \\cdot 10^{2}} = 0,6 \\cdot 10^{6} = 6 \\cdot 10^{5}\\ \\text{mol}"
