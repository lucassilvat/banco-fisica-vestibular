{
  "id": "unesp-2025-q77",
  "formato": "aula",
  "titulo": "As duas componentes da velocidade inicial",
  "conceitos": [
    "Lançamento oblíquo",
    "Composição de movimentos"
  ],
  "cena": {
    "modelo": "lancamento-obliquo",
    "parametros": {
      "coef": [
        -0.2,
        1.6,
        4
      ],
      "xC": 10,
      "tB": 0.8,
      "tC": 2,
      "vx": 5,
      "vy": 8
    }
  },
  "metodos": [
    {
      "nome": "Componente por componente",
      "telas": [
        {
          "titulo": "Dois movimentos ao mesmo tempo",
          "cena": {
            "mostrar": [
              "eixos",
              "terreno",
              "trajetoria",
              "pontos",
              "bola"
            ],
            "estado": {
              "lancar": true
            }
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Sem resistência do ar, o movimento se decompõe em dois: na horizontal, <b>uniforme</b>; na vertical, <b>uniformemente variado</b>, com aceleração g."
            },
            {
              "t": "texto",
              "html": "Vamos achar cada componente de v<sub>0</sub> e depois compô-las."
            }
          ]
        },
        {
          "titulo": "Componente vertical",
          "cena": {
            "mostrar": [
              "eixos",
              "terreno",
              "trajetoria",
              "pontos",
              "bola",
              "velocidade-b"
            ],
            "estado": {
              "lancar": false,
              "t": 0.8
            },
            "destacar": [
              "velocidade-b"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Em B, o ponto mais alto, a componente vertical da velocidade é <b>nula</b>."
            },
            {
              "t": "eq",
              "tex": "v_{y} = v_{0y} - g\\, t"
            },
            {
              "t": "eq",
              "tex": "0 = v_{0y} - \\marca{g}{10 \\cdot 0,8}"
            },
            {
              "t": "eq",
              "tex": "\\marca{g}{10 \\cdot 0,8} = v_{0y}",
              "mover": [
                "g"
              ]
            },
            {
              "t": "eq",
              "tex": "v_{0y} = 8\\ \\text{m/s}"
            }
          ]
        },
        {
          "titulo": "Componente horizontal",
          "cena": {
            "mostrar": [
              "eixos",
              "terreno",
              "trajetoria",
              "pontos",
              "bola",
              "vertice"
            ],
            "estado": {
              "lancar": false,
              "t": 0.8
            },
            "destacar": [
              "vertice"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A abscissa de B é a do <b>vértice</b> da parábola y = −0,2x² + 1,6x + 4:"
            },
            {
              "t": "eq",
              "tex": "x_{B} = -\\dfrac{b}{2a} = \\dfrac{\\marca{m}{-}1,6}{2 \\cdot (\\marca{n}{-}0,2)}"
            },
            {
              "t": "eq",
              "tex": "x_{B} = \\dfrac{1,6}{0,4} = 4\\ \\text{m}",
              "cancelar": [
                "m",
                "n"
              ]
            },
            {
              "t": "texto",
              "html": "Na horizontal o movimento é uniforme: a bola anda 4 m em 0,8 s."
            },
            {
              "t": "eq",
              "tex": "v_{0x} = \\dfrac{4}{0,8} = 5\\ \\text{m/s}"
            }
          ]
        },
        {
          "titulo": "O módulo da velocidade inicial",
          "cena": {
            "mostrar": [
              "eixos",
              "terreno",
              "trajetoria",
              "pontos",
              "bola",
              "componentes"
            ],
            "estado": {
              "lancar": false,
              "t": 0
            },
            "destacar": [
              "componentes"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "As componentes são <b>perpendiculares</b>: o módulo vem do teorema de Pitágoras."
            },
            {
              "t": "eq",
              "tex": "v_{0}^{2} = v_{0x}^{2} + v_{0y}^{2} = 5^{2} + 8^{2}"
            },
            {
              "t": "eq",
              "tex": "v_{0}^{2} = 89"
            },
            {
              "t": "eq",
              "tex": "v_{0} = \\sqrt{89}\\ \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
  "status": "revisado",
  "criadoEm": "2026-11-15T09:00:00-03:00",
  "atualizadoEm": "2026-11-15T09:00:00-03:00"
}
