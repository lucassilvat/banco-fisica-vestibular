  "metodos": [
    {
      "nome": "Relações métricas",
      "telas": [
        {
          "titulo": "O triângulo é retângulo",
          "cena": {
            "mostrar": [
              "triangulo",
              "relacoes"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Os lados satisfazem o teorema de Pitágoras:"
            },
            {
              "t": "eq",
              "tex": "60^{2} + 80^{2} = 3\\,600 + 6\\,400 = 10\\,000 = 100^{2}"
            },
            {
              "t": "texto",
              "html": "O triângulo ABC é <b>retângulo em B</b>, e BD é a altura relativa à hipotenusa AC."
            }
          ]
        },
        {
          "titulo": "Os lados que faltam",
          "cena": {
            "mostrar": [
              "triangulo",
              "relacoes",
              "medidas"
            ],
            "destacar": [
              "medidas"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Relações métricas no triângulo retângulo:"
            },
            {
              "t": "eq",
              "tex": "BD = \\dfrac{AB \\cdot BC}{AC} = \\dfrac{60 \\cdot 80}{100} = 48\\ \\text{m}"
            },
            {
              "t": "eq",
              "tex": "DC = \\dfrac{BC^{2}}{AC} = \\dfrac{6\\,400}{100} = 64\\ \\text{m}"
            }
          ]
        },
        {
          "titulo": "A velocidade média",
          "cena": {
            "mostrar": [
              "triangulo",
              "relacoes",
              "medidas",
              "volta",
              "pessoa"
            ],
            "animar": [
              "correr"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A volta BCDB:"
            },
            {
              "t": "eq",
              "tex": "\\Delta s = 80 + 64 + 48 = 192\\ \\text{m}"
            },
            {
              "t": "eq",
              "tex": "v_{m} = \\dfrac{192}{40} = 4,8\\ \\text{m/s}"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
