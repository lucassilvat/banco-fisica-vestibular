  "metodos": [
    {
      "nome": "Queda livre e colisão",
      "telas": [
        {
          "titulo": "A queda e o choque",
          "cena": {
            "mostrar": [
              "teto",
              "mola",
              "prato",
              "pacote",
              "altura"
            ],
            "animar": [
              "cair",
              "prato-desce",
              "mola-estica"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Na queda, a energia potencial vira cinética. A <b>massa</b> aparece dos dois lados e <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "\\marca{a}{m}\\, g\\, h = \\dfrac{\\marca{b}{m}\\, v^{2}}{2}"
            },
            {
              "t": "eq",
              "tex": "v^{2} = 2 g h",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "eq",
              "tex": "v = \\sqrt{2 \\cdot 10 \\cdot 0,45} = \\sqrt{9}"
            },
            {
              "t": "eq",
              "tex": "v = 3\\ \\text{m/s}"
            },
            {
              "t": "texto",
              "html": "No choque, o pacote <b>gruda</b> no prato, e os dois passam a descer <b>juntos</b>, mais devagar."
            }
          ]
        },
        {
          "titulo": "Antes e depois da colisão",
          "cena": {
            "mostrar": [
              "foto-antes",
              "foto-depois"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Duas fotografias: <b>imediatamente antes</b> e <b>imediatamente depois</b> da colisão. Nesse instante tão curto, o sistema é isolado: a <b>quantidade de movimento se conserva</b>."
            },
            {
              "t": "eq",
              "tex": "m \\cdot 3 = (m + 0,2) \\cdot 2"
            },
            {
              "t": "eq",
              "tex": "3m = \\marca{x}{2m} + 0,4"
            },
            {
              "t": "eq",
              "tex": "3m - \\marca{x}{2m} = 0,4",
              "mover": [
                "x"
              ]
            },
            {
              "t": "eq",
              "tex": "m = 0,4\\ \\text{kg} = 400\\ \\text{g}"
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
