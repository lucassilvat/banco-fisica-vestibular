  "metodos": [
    {
      "nome": "Calor sensível e fusão",
      "telas": [
        {
          "titulo": "A temperatura final",
          "cena": {
            "mostrar": [
              "eixos"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Na fase líquida, o gálio recebe Q = 80 J de calor sensível a partir de T<sub>2</sub> = 30 °C:"
            },
            {
              "t": "eq",
              "tex": "Q = m\\, c\\, \\Delta T"
            },
            {
              "t": "eq",
              "tex": "80 = \\marca{m}{10 \\cdot 0,4} \\cdot \\Delta T"
            },
            {
              "t": "eq",
              "tex": "\\Delta T = \\dfrac{80}{\\marca{m}{10 \\cdot 0,4}} = \\dfrac{80}{4} = 20\\ ^{\\circ}\\text{C}",
              "mover": [
                "m"
              ]
            },
            {
              "t": "eq",
              "tex": "T_{3} = 30 + 20 = 50\\ ^{\\circ}\\text{C}"
            }
          ]
        },
        {
          "titulo": "Sólido e fusão",
          "cena": {
            "mostrar": [
              "eixos",
              "solido",
              "fusao"
            ],
            "destacar": [
              "fusao"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O sólido aquece de 20 °C a 30 °C. Na <b>fusão</b>, recebe calor e a temperatura <b>não muda</b>: o gráfico tem um patamar em 30 °C."
            },
            {
              "t": "texto",
              "html": "O gráfico c não tem patamar, e o d mostra resfriamento: estão fora."
            }
          ]
        },
        {
          "titulo": "O líquido",
          "cena": {
            "mostrar": [
              "eixos",
              "solido",
              "fusao",
              "liquido"
            ],
            "destacar": [
              "liquido"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Depois da fusão, o líquido aquece até <b>50 °C</b>, atingidos em t = 230 s."
            },
            {
              "t": "texto",
              "html": "O gráfico a chega a 120 °C em 230 s. Só o b tem o patamar em 30 °C e chega a 50 °C em 230 s."
            },
            {
              "t": "gabarito",
              "letra": "b"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
