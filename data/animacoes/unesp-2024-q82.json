  "metodos": [
    {
      "nome": "Soma dos dois campos",
      "telas": [
        {
          "titulo": "O campo do solenoide",
          "cena": {
            "mostrar": [
              "face",
              "bobina",
              "b-sol"
            ],
            "destacar": [
              "b-sol"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A corrente entra pela direita, sobe <b>por trás</b> da face, passa por cima e desce <b>pela frente</b>, avançando para a esquerda."
            },
            {
              "t": "texto",
              "html": "Pela <b>regra da mão direita</b>, com os dedos acompanhando esse giro, o polegar aponta para a <b>direita</b>: o campo do solenoide no eixo é horizontal, para a direita."
            }
          ]
        },
        {
          "titulo": "O campo da Terra",
          "cena": {
            "mostrar": [
              "face",
              "bobina",
              "b-sol",
              "b-t"
            ],
            "destacar": [
              "b-t"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O campo da Terra, \\(\\vec{B}_{T}\\), é <b>vertical, para cima</b>, no plano da figura."
            }
          ]
        },
        {
          "titulo": "O campo sentido pelo tubarão",
          "cena": {
            "mostrar": [
              "face",
              "bobina",
              "b-sol",
              "b-t",
              "b-res"
            ],
            "destacar": [
              "b-res"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "O tubarão sente a <b>soma vetorial</b> dos dois campos:"
            },
            {
              "t": "eq",
              "tex": "\\vec{B} = \\vec{B}_{\\text{sol}} + \\vec{B}_{T}"
            },
            {
              "t": "texto",
              "html": "Um vetor para a direita somado a um para cima dá um vetor <b>inclinado para cima e para a direita</b>, no plano da figura."
            },
            {
              "t": "gabarito",
              "letra": "B"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
