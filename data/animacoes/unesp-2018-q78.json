  "passos": [
    {
      "titulo": "A explosão",
      "conceito": "Conservação da quantidade de movimento",
      "texto": "Na explosão, as forças internas são muito maiores que o peso: a quantidade de movimento se conserva. Com M<sub>B</sub> = m e M<sub>A</sub> = 2m:",
      "equacoes": [
        "3m V_{\\text{H}} = 2m V_{\\text{A}} + m \\cdot 5V_{\\text{H}} \\quad \\Rightarrow \\quad V_{\\text{A}} = -V_{\\text{H}}"
      ],
      "cena": {
        "mostrar": [
          "solo",
          "subida",
          "explosao"
        ]
      }
    },
    {
      "titulo": "A queda de A",
      "conceito": "Lançamento oblíquo",
      "texto": "A sai do topo com velocidade horizontal de mesmo módulo que antes, mas para trás. A queda leva o mesmo tempo da subida, em que o projétil andou 2d (de II até IV). Para trás, A anda 2d: cai em II. Resposta: <b>(E)</b>.",
      "cena": {
        "mostrar": [
          "volta",
          "fragmento-a"
        ],
