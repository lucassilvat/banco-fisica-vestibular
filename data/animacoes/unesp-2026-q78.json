{
  "id": "unesp-2026-q78",
  "formato": "aula",
  "titulo": "Quanto subiria o motorista com a energia da gasolina",
  "conceitos": [
    "Energia potencial gravitacional",
    "Densidade",
    "Rendimento"
  ],
  "metodos": [
    {
      "nome": "Seguindo a energia",
      "telas": [
        {
          "titulo": "O combustível gasto",
          "blocos": [
            {
              "t": "texto",
              "html": "Primeiro, quanto combustível foi gasto."
            },
            {
              "t": "texto",
              "html": "Em 2 h a 50 km/h, o carro percorre:"
            },
            {
              "t": "eq",
              "tex": "d = 50 \\cdot 2 = 100\\ \\text{km}"
            },
            {
              "t": "texto",
              "html": "Com 10 km por litro, isso consome <b>10 L</b> de gasolina, isto é:"
            },
            {
              "t": "eq",
              "tex": "m_{\\text{gas}} = 10\\ \\text{L} \\cdot 0,7\\ \\text{kg/L} = 7\\ \\text{kg}"
            }
          ]
        },
        {
          "titulo": "A energia que move o motorista",
          "blocos": [
            {
              "t": "texto",
              "html": "Só <b>1%</b> da energia da combustão move o motorista:"
            },
            {
              "t": "eq",
              "tex": "E = 0,01 \\cdot 7 \\cdot 4 \\times 10^{7}\\ \\text{J}"
            },
            {
              "t": "texto",
              "html": "Toda essa energia vira <b>energia potencial gravitacional</b> do motorista:"
            },
            {
              "t": "eq",
              "tex": "m g h = E"
            }
          ]
        },
        {
          "titulo": "A altura",
          "blocos": [
            {
              "t": "texto",
              "html": "Isolando a altura e substituindo:"
            },
            {
              "t": "eq",
              "tex": "h = \\dfrac{0,01 \\cdot 7 \\cdot 4 \\times 10^{7}}{70 \\cdot 10}"
            },
            {
              "t": "texto",
              "html": "Escrevendo 70 = 7 · 10:"
            },
            {
              "t": "eq",
              "tex": "h = \\dfrac{0,01 \\cdot \\marca{a}{7} \\cdot 4 \\times 10^{7}}{\\marca{b}{7} \\cdot 10 \\cdot 10}"
            },
            {
              "t": "texto",
              "html": "O 7 de cima <b>cancela</b> com o 7 de baixo:"
            },
            {
              "t": "eq",
              "tex": "h = \\dfrac{0,01 \\cdot 4 \\times 10^{7}}{10 \\cdot 10}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "eq",
              "tex": "h = \\dfrac{4 \\times 10^{5}}{10^{2}}"
            },
            {
              "t": "eq",
              "tex": "h = 4\\,000\\ \\text{m}"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
