  "metodos": [
    {
      "nome": "Área do gráfico",
      "telas": [
        {
          "titulo": "A velocidade máxima",
          "cena": {
            "mostrar": [
              "grafico",
              "inclinacao"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Na fase de aceleração, o veículo parte do repouso e chega a V<sub>máx</sub> em T<sub>1</sub>:"
            },
            {
              "t": "eq",
              "tex": "V_{\\text{máx}} = a_{1}\\, T_{1}"
            }
          ]
        },
        {
          "titulo": "O deslocamento",
          "cena": {
            "mostrar": [
              "grafico",
              "area"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "No gráfico v × t, o <b>deslocamento é a área</b> sob a curva: um triângulo de base T<sub>1</sub> + T<sub>2</sub> e altura V<sub>máx</sub>."
            },
            {
              "t": "eq",
              "tex": "\\Delta s = \\dfrac{V_{\\text{máx}}\\,(T_{1} + T_{2})}{2}"
            }
          ]
        },
        {
          "titulo": "A velocidade média",
          "cena": {
            "mostrar": [
              "grafico",
              "area",
              "media"
            ],
            "destacar": [
              "media"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A velocidade média divide esse deslocamento pelo tempo total, T<sub>1</sub> + T<sub>2</sub>, que <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "v_{m} = \\dfrac{V_{\\text{máx}}\\,\\marca{a}{(T_{1} + T_{2})}}{2\\,\\marca{b}{(T_{1} + T_{2})}}"
            },
            {
              "t": "eq",
              "tex": "v_{m} = \\dfrac{V_{\\text{máx}}}{2}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "eq",
              "tex": "v_{m} = \\dfrac{a_{1} \\times T_{1}}{2}"
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
