          "titulo": "O calor da combustão",
          "blocos": [
            {
              "t": "texto",
              "html": "ΔH da combustão: produtos menos reagentes (O<sub>2</sub> tem entalpia de formação nula):"
            },
            {
              "t": "eq",
              "tex": "\\Delta H = [4(-393) + 5(-286)] - [(-126)]"
            },
            {
              "t": "eq",
              "tex": "\\Delta H = -1\\,572 - 1\\,430 + 126 = -2\\,876\\ \\text{kJ}"
            },
            {
              "t": "texto",
              "html": "Calor liberado: 2 876 kJ = 2,876 · 10<sup>6</sup> J."
            }
          ]
        },
        {
          "titulo": "O gelo derretido",
          "blocos": [
            {
              "t": "texto",
              "html": "Todo esse calor funde o gelo a 0 ºC. Isolamos a massa:"
            },
            {
              "t": "eq",
              "tex": "Q = m\\, \\marca{l}{L}"
            },
            {
              "t": "eq",
              "tex": "m = \\dfrac{Q}{\\marca{l}{L}}",
              "mover": [
                "l"
              ]
            },
            {
              "t": "eq",
              "tex": "m = \\dfrac{2,876 \\cdot 10^{6}}{320} \\approx 8\\,990\\ \\text{g}"
            },
            {
              "t": "eq",
              "tex": "m \\approx 9\\ \\text{kg}"
            },
            {
              "t": "gabarito",
              "letra": "E"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
