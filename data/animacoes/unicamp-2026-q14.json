  "id": "unicamp-2026-q14",
  "formato": "aula",
  "titulo": "A força que freia a moto",
  "conceitos": [
    "Movimento uniformemente variado",
    "Leis de Newton"
  ],
  "metodos": [
    {
      "nome": "Segunda lei de Newton",
      "telas": [
        {
          "titulo": "A aceleração",
          "blocos": [
            {
              "t": "texto",
              "html": "No trecho II, a velocidade cai de 36 km/h = 10 m/s até zero, entre t = 30 s e t = 50 s:"
            },
            {
              "t": "eq",
              "tex": "a = \\dfrac{\\Delta v}{\\Delta t} = \\dfrac{0 - 10}{50 - 30}"
            },
            {
              "t": "eq",
              "tex": "a = \\dfrac{-10}{20} = -0,5\\ \\text{m/s}^{2}"
            },
            {
              "t": "texto",
              "html": "O sinal negativo indica a desaceleração."
            }
          ]
        },
        {
          "titulo": "A força resultante",
          "blocos": [
            {
              "t": "texto",
              "html": "Pela 2ª lei de Newton:"
            },
            {
              "t": "eq",
              "tex": "F_{R} = m\\, a"
            },
            {
              "t": "eq",
              "tex": "F_{R} = 180 \\cdot (-0,5) = -90\\ \\text{N}"
            },
            {
              "t": "texto",
              "html": "O sinal indica que a força é contrária ao movimento. O módulo é <b>90 N</b>."
            },
            {
              "t": "gabarito",
              "letra": "b"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
  ],
