  "metodos": [
    {
      "nome": "Queda livre e energia",
      "telas": [
        {
          "titulo": "A queda",
          "cena": {
            "mostrar": [
              "cena",
              "madeira",
              "aco",
              "mesmo"
            ],
            "animar": [
              "cai-m",
              "cai-a"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "Sem resistência do ar, as duas caem com a <b>mesma aceleração g</b>. Da conservação da energia, a massa <b>cancela</b>:"
            },
            {
              "t": "eq",
              "tex": "\\marca{a}{m}\\, g\\, h = \\dfrac{\\marca{b}{m}\\, v^{2}}{2}"
            },
            {
              "t": "eq",
              "tex": "v = \\sqrt{2 g h}",
              "cancelar": [
                "a",
                "b"
              ]
            },
            {
              "t": "texto",
              "html": "Mesma altura: chegam <b>juntas</b> e com a <b>mesma velocidade</b>. (A), (C) e (E) são falsas."
            }
          ]
        },
        {
          "titulo": "As energias",
          "cena": {
            "mostrar": [
              "cena",
              "madeira",
              "aco",
              "mesmo",
              "energia"
            ],
            "destacar": [
              "energia"
            ]
          },
          "blocos": [
            {
              "t": "texto",
              "html": "A energia mecânica inicial, m g h, depende da massa: (B) é falsa."
            },
            {
              "t": "texto",
              "html": "No solo, com o mesmo v para as duas:"
            },
            {
              "t": "eq",
              "tex": "E_{c} = \\dfrac{m v^{2}}{2}"
            },
            {
              "t": "texto",
              "html": "A esfera de aço, de massa maior, chega com <b>mais energia cinética</b>."
            },
            {
              "t": "gabarito",
              "letra": "D"
            },
            {
              "t": "fim"
            }
          ]
        }
      ]
    }
